{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "resources/js/**",
      "resources/widget/**",
      "sdk/**",
      "!sdk/*/dist",
      "!sdk/api/src/schema.ts",
      "!sdk/api/src/paging.ts",
      "!sdk/*/api-report",
      "!sdk/**/*.md",
      "!sdk/go",
      "!sdk/php",
      "!sdk/laravel",
      "!sdk/python",
      "!sdk/examples",
      "scripts/**",
      "!resources/js/route-tree.gen.ts",
      "!resources/js/components",
      "!resources/js/styles",
      "!resources/js/utils",
      "site/**",
      "!site/dist",
      "!site/public",
      "!site/index.html",
      "vite.config.ts",
      "package.json",
      "tsconfig.json",
      "tsconfig.node.json",
      "biome.json",
      "boardui.json",
      "tests/e2e/**",
      "playwright.config.ts",
      "tsconfig.e2e.json",
      "deploy/cdk/**",
      "deploy/dns/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noParameterAssign": "error",
        "useBlockStatements": "error",
        "noUselessElse": "error",
        "useNodejsImportProtocol": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["resources/widget/lib/report.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
