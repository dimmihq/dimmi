{%- comment -%}
  The frame of every page: a top bar with the logo, the sections, the
  language and theme menus, a way to a person and the reader's sign-in;
  the page in one column; then the team's footer text, its contact link
  and the dimmi mark. Pages that list something to browse fill
  `sidebar`, which slides in as a drawer from the start edge.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="{{ locale.code }}" dir="{{ locale.dir }}" style="{{ help_center.brand_style }}" data-appearance="{{ help_center.appearance }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="{{ help_center.color_scheme }}">
<meta name="view-transition" content="same-origin">
<meta name="turbo-cache-control" content="no-preview">
<title>{{ page.title }}</title>
<meta name="theme-color" content="{{ help_center.brand }}">
{%- if help_center.tab_icon != "" %}
<link rel="icon" href="{{ help_center.tab_icon }}">
{%- else %}
<link rel="icon" href="data:,">
{%- endif %}
{{ seo_tags }}
{{ platform_assets }}
{% render 'drawer_style' %}
{{ messenger_snippet }}
</head>
<body class="bg-background-full font-inter text-text-primary">
<a href="#main" class="sr-only rounded-xl bg-background-primary-default px-4 py-2 text-body-medium focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50">{{ 'skip_to_content' | t }}</a>
{%- if page.has_drawer %}
{% render 'drawer_panel', sidebar: sidebar %}
{%- endif %}
<div data-page class="relative flex min-h-dvh min-w-0 flex-col">
{%- if page.has_drawer %}
<div data-drawer-backdrop aria-hidden="true" class="absolute inset-0 z-40"></div>
{%- endif %}
{% render 'top_bar' %}
<main id="main" class="flex-1 pb-24">
{{ content_for_layout }}
</main>
<footer class="flex flex-col items-center gap-4 px-4 pb-8 text-center">
{%- if help_center.footer_text != "" or help_center.contact_url != "" %}
<div class="flex max-w-[40rem] flex-col items-center gap-2 text-body-2-regular text-text-tertiary">
{%- if help_center.footer_text != "" %}
<p class="whitespace-pre-line">{{ help_center.footer_text }}</p>
{%- endif %}
{%- if help_center.contact_url != "" %}
<a href="{{ help_center.contact_url }}" class="text-link hover:underline">{{ 'contact_us' | t }}</a>
{%- endif %}
</div>
{%- endif %}
<a href="https://trydimmi.com" class="inline-flex items-center gap-1.5 rounded-full border border-border-button-default px-2.5 py-1 text-caption-1-medium text-text-tertiary transition-colors hover:text-text-primary">
<svg viewBox="4 4 40 40" width="12" height="12" class="size-3" fill="currentColor" aria-hidden="true"><path d="M4 24a20 20 0 0 1 13.7-19L43 30.3A20 20 0 0 1 24 44H11a7 7 0 0 1-7-7Z"></path><path d="M19.8 4.5a20 20 0 0 1 4.9-.5L44 23.3a20 20 0 0 1-.5 4.9Z"></path><path d="M27.6 4.3A20 20 0 0 1 35 7.3l5.7 5.7a20 20 0 0 1 3 7.4Z"></path></svg>
{{ 'powered_by' | t }}
</a>
</footer>
</div>
</body>
</html>
