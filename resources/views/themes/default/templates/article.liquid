{%- comment -%}
  An article: the way back to its collection, its title and summary, a
  menu to take its Markdown elsewhere, who wrote it and when it last
  changed, the body, whether it helped and the articles before and after
  it. Beside it on wide screens sit its contents and the other articles
  of its collection.
{%- endcomment -%}
{%- capture sidebar %}{% render 'help_sidebar', current: article.collection_slug, article: article.slug %}{% endcapture -%}
<div class="mx-auto grid w-full max-w-[66rem] gap-14 px-5 pt-10 md:pt-14 xl:grid-cols-[minmax(0,1fr)_15rem]">
<article class="min-w-0 w-full max-w-[42.5rem] animate-rise max-xl:mx-auto">
{%- if article.untranslated != "" %}
<p data-untranslated class="mb-5 flex items-start gap-2.5 rounded-xl border border-border-button-default bg-background-secondary-default px-3.5 py-2.5 text-body-2-regular text-text-secondary">{{ 'globe' | icon: 'mt-0.5 size-4 shrink-0 text-foreground-icon-tertiary' }}<span>{{ 'untranslated' | t: language: article.untranslated }}</span></p>
{%- endif %}
{% render 'breadcrumb', crumbs: breadcrumb %}
<div class="mt-5 flex items-start justify-between gap-6">
<h1 class="min-w-0 flex-1 text-display-4-medium tracking-tight text-balance"{% if article.original_lang != "" %} lang="{{ article.original_lang }}"{% endif %}>{{ article.title }}</h1>
<div class="pt-1.5 max-sm:hidden">{% render 'copy_menu', article: article %}</div>
</div>
{%- if article.description != "" %}
<p class="mt-3 text-title-3-regular text-text-secondary">{{ article.description }}</p>
{%- endif %}
<div class="mt-5 flex items-center gap-3 text-body-2-regular">
{%- if article.author.name != "" %}
{% render 'avatar', person: article.author, size: 'size-9 text-caption-1-semibold' %}
{%- endif %}
<p class="grid">
{%- if article.author.name != "" %}
<span class="text-text-secondary">{{ 'written_by' | t: name: article.author.name }}</span>
{%- endif %}
{%- capture when %}<time datetime="{{ article.updated | format_date: 'iso' }}" title="{{ article.updated | format_date }}">{{ article.age }}</time>{% endcapture %}
<span class="text-text-tertiary">{% if article.age_known %}{{ 'updated_ago' | t: ago: when }}{% else %}{{ 'updated' | t: date: when }}{% endif %} <span aria-hidden="true">·</span> {{ 'reading_time' | t: count: article.minutes }}</span>
</p>
</div>
<div class="prose mt-8"{% if article.original_lang != "" %} lang="{{ article.original_lang }}"{% endif %}>{{ article.body }}</div>
{% render 'feedback', article: article %}
{% render 'neighbors', article: article %}
</article>
<aside class="flex flex-col gap-8 max-xl:hidden">
<div data-rail class="sticky top-24 flex max-h-[calc(100dvh-8rem)] flex-col gap-8 overflow-y-auto overscroll-contain pb-8 [mask-image:linear-gradient(to_bottom,black_calc(100%-3rem),transparent)] [scrollbar-width:none]">
{%- if article.contents.size > 0 %}
{% render 'contents', headings: article.contents %}
{%- endif %}
{%- if article.collection and article.collection.articles.size > 1 %}
{%- assign in_collection = 'in_collection' | t: name: article.collection.title %}
<nav aria-label="{{ in_collection }}">
<p class="text-caption-1-medium text-text-tertiary">{{ in_collection }}</p>
<ul class="mt-3 flex flex-col gap-2">
{%- for s in article.collection.articles %}
{%- if s.slug != article.slug %}
<li><a href="{{ s.url }}" class="block text-body-2-regular text-text-secondary transition-colors hover:text-text-primary">{{ s.title }}</a></li>
{%- endif %}
{%- endfor %}
</ul>
</nav>
{%- endif %}
</div>
</aside>
</div>
