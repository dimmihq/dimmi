{%- comment -%}
  Where a subscriber's link lands. Nothing changes until the button is
  pressed, so a mail scanner opening the link does nothing.
{%- endcomment -%}
<div class="mx-auto flex w-full max-w-[30rem] flex-col items-center px-5 pt-20 pb-24 text-center">
<span class="grid size-12 place-items-center rounded-full bg-tint text-link">{{ 'mail' | icon: 'size-5' }}</span>
<h1 class="mt-5 text-title-1-medium tracking-tight">{{ subscription.title }}</h1>
{%- if subscription.invalid %}
<p class="mt-3 text-body-regular text-text-secondary">{{ 'subscription_link_expired' | t }}</p>
{%- elsif subscription.done %}
<p role="status" class="mt-3 text-body-regular text-text-secondary">{{ subscription.done_text }}</p>
{%- else %}
<p class="mt-3 text-body-regular text-text-secondary">{{ subscription.ask }}</p>
<form method="post" action="{{ subscription.action }}" class="mt-7">
{{ form_token_field }}
<button type="submit" class="button-brand inline-flex h-10 cursor-pointer items-center rounded-xl px-5 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">{{ subscription.button }}</button>
</form>
{%- endif %}
<a href="{{ help_center.changelog_url }}" class="mt-8 text-body-2-medium text-link hover:underline">{{ 'back_to_changelog' | t }}</a>
</div>
