{%- comment -%}One changelog entry in full, with the articles that explain it, reactions, a way to ask about it and the entries around it.{%- endcomment -%}
<article class="mx-auto w-full max-w-[44rem] px-5 pt-12 md:pt-16">
<div class="stagger">
<p class="flex flex-wrap items-center gap-3 text-body-medium text-text-secondary"><time datetime="{{ entry.published | format_date: 'iso' }}">{{ entry.published | format_date }}</time>{% if entry.version != "" %}{% render 'version', version: entry.version %}{% endif %}{% render 'labels', labels: entry.labels %}</p>
<h1 class="mt-4 text-display-3-medium tracking-tight text-balance max-md:text-display-4-medium">{{ entry.title }}</h1>
<p class="mt-3 text-title-3-regular text-text-secondary">{{ entry.summary }}</p>
{%- if entry.authors.size > 0 %}
<p class="mt-6 flex items-center gap-2.5 text-body-2-regular text-text-tertiary">{% render 'avatars', people: entry.authors %}{{ entry.author_names }}</p>
{%- endif %}
</div>
{%- if entry.cover != "" %}
<img src="{{ entry.cover }}" alt="" width="1600" height="900" decoding="async" class="mt-10 aspect-video w-full animate-rise rounded-2xl border border-separator-border object-cover">
{%- endif %}
<div class="prose mt-10">{{ entry.body }}</div>
{%- if entry.related.size > 0 %}
<section class="mt-12">
<h2 class="text-body-medium text-text-secondary">{{ 'learn_more' | t }}</h2>
<ul class="mt-3 grid gap-3 sm:grid-cols-2">
{%- for a in entry.related %}
<li class="flex"><a href="{{ a.url }}" class="group flex w-full items-start gap-3 rounded-2xl border border-border-button-default bg-background-primary-default p-4 transition hover:border-border-button-hover hover:shadow-sm"><span class="grid size-8 shrink-0 place-items-center rounded-lg bg-background-secondary-default text-link">{{ 'book' | icon: 'size-4' }}</span><span class="min-w-0"><span class="block text-body-medium">{{ a.title }}</span><span class="mt-0.5 line-clamp-2 block text-body-2-regular text-text-tertiary">{{ a.description }}</span></span></a></li>
{%- endfor %}
</ul>
</section>
{%- endif %}
<div class="mt-12 flex flex-wrap items-center gap-4 border-y border-separator-border py-5">
{% render 'reactions', entry: entry %}
{%- assign lead = 'questions' | t | append: ' ' %}
{% render 'help_button', class: 'ms-auto inline-flex items-center gap-1.5 text-body-medium text-text-secondary transition-colors hover:text-text-primary', lead: lead, icon_class: 'size-4' %}
</div>
{%- if previous or next %}
<nav aria-label="{{ 'more_updates' | t }}" class="mt-6 grid gap-3 sm:grid-cols-2">
{%- if previous %}
<a href="{{ previous.url }}" class="group flex flex-col rounded-2xl border border-border-button-default p-4 transition hover:border-border-button-hover hover:bg-background-secondary-hover "><span class="text-caption-1-medium text-text-tertiary">{{ 'older' | t }} · {{ previous.published | format_date: 'short' }}</span><span class="mt-1 text-body-medium group-hover:text-link">{{ previous.title }}</span></a>
{%- else %}
<span></span>
{%- endif %}
{%- if next %}
<a href="{{ next.url }}" class="group flex flex-col rounded-2xl border border-border-button-default p-4 transition hover:border-border-button-hover hover:bg-background-secondary-hover sm:items-end sm:text-end"><span class="text-caption-1-medium text-text-tertiary">{{ 'newer' | t }} · {{ next.published | format_date: 'short' }}</span><span class="mt-1 text-body-medium group-hover:text-link">{{ next.title }}</span></a>
{%- endif %}
</nav>
{%- endif %}
{%- unless changelog.no_subscribe %}
<section class="mt-12 flex flex-col items-center rounded-3xl border border-border-button-default bg-background-secondary-default px-6 py-8 text-center">
<h2 class="text-headline-semibold">{{ 'updates_inbox' | t }}</h2>
<p class="mt-1 text-body-regular text-text-secondary">{{ 'updates_inbox_body' | t }}</p>
<div class="mt-5 w-full max-w-[24rem]">{% render 'subscribe', subscribed: false %}</div>
</section>
{%- endunless %}
</article>
