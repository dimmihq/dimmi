{%- comment -%}
  One request on its own page: where it stands, its details, its votes,
  the update that shipped it, and the conversation under it.
{%- endcomment -%}
<article class="stagger mx-auto w-full max-w-[44rem] px-5 pt-12 pb-20 md:pt-16">
{% render 'back_to_board' %}
<div class="mt-5 flex items-start gap-5">
{% render 'vote_button', idea: request.idea %}
<div class="min-w-0 flex-1">
<span class="inline-flex items-center gap-1.5 rounded-full bg-background-secondary-default px-2.5 py-1 text-caption-1-medium text-text-secondary">{% render 'status_icon', status: request.status %}{{ request.status.name }}</span>
<h1 class="mt-3 text-display-4-medium tracking-tight text-balance">{{ request.idea.title }}</h1>
<p class="mt-2 text-body-2-regular text-text-tertiary">{{ request.author }} · {{ request.posted }}</p>
</div>
</div>
{%- if request.pending %}
<p role="status" class="mt-6 rounded-xl bg-background-secondary-default px-4 py-3 text-body-regular text-text-secondary">{{ 'only_you_until_approved' | t }}</p>
{%- endif %}
{%- if request.update_url != "" %}
<a href="{{ request.update_url }}" class="mt-6 flex items-center gap-2 rounded-xl border border-border-button-default bg-background-primary-default px-4 py-3 text-body-medium transition-colors hover:border-border-button-hover">{{ 'megaphone' | icon: 'size-4 text-link' }}{{ 'shipped_read' | t }}{{ 'arrow-right' | icon: 'ms-auto size-4 text-foreground-icon-tertiary' }}</a>
{%- endif %}
{%- if request.details != "" %}
<div class="prose mt-8">{{ request.details }}</div>
{%- endif %}
<section aria-labelledby="comments-title" class="mt-12 border-t border-separator-border pt-8">
<h2 id="comments-title" class="text-headline-semibold">{{ 'comments' | t }}</h2>
{%- if request.comments.size == 0 %}
<p class="mt-3 text-body-regular text-text-tertiary">{{ 'no_comments' | t }}</p>
{%- endif %}
<ol class="mt-5 flex flex-col gap-5">
{%- for c in request.comments %}
{% render 'comment', comment: c %}
{%- endfor %}
</ol>
{%- if request.commented %}
<p role="status" class="mt-6 text-body-2-regular text-text-secondary">{{ 'comment_posted' | t }}</p>
{%- endif %}
{%- if request.can_act %}
<form method="post" action="{{ request.comment_url }}" class="mt-6 flex flex-col gap-3">
{{ form_token_field }}
<label class="sr-only" for="comment-body">{{ 'add_comment' | t }}</label>
<textarea id="comment-body" name="body" rows="3" required maxlength="5000" placeholder="{{ 'add_comment' | t }}" class="rounded-xl border border-border-button-default bg-background-primary-default px-3 py-2.5 text-body-regular shadow-xs outline-none transition placeholder:text-text-placeholder hover:border-border-button-hover focus:border-border-button-hover focus:ring-4 focus:ring-tint"></textarea>
<button type="submit" class="button-brand inline-flex h-9 cursor-pointer items-center self-start rounded-xl px-4 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">{{ 'comment' | t }}</button>
</form>
{%- elsif request.sign_in_url != "" %}
<a href="{{ request.sign_in_url }}" class="mt-6 inline-flex h-9 items-center rounded-xl border border-border-button-default px-4 text-body-medium transition-colors hover:border-border-button-hover">{{ 'sign_in_to_comment' | t }}</a>
{%- endif %}
</section>
</article>
