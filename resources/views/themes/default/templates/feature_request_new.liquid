{%- comment -%}
  The form to suggest a feature. When similar requests exist it shows
  them first, so the reader can vote for one, or post theirs anyway.
{%- endcomment -%}
<div class="stagger mx-auto w-full max-w-[36rem] px-5 pt-12 md:pt-16">
{% render 'back_to_board' %}
<h1 class="mt-5 text-display-4-medium tracking-tight">{{ 'submit_an_idea' | t }}</h1>
<p class="mt-2 text-title-3-regular text-text-secondary">{{ 'idea_tagline' | t }}</p>
{%- if form.error != "" %}
<p role="alert" class="mt-6 rounded-xl border border-border-error-default px-4 py-3 text-body-regular text-text-error-primary">{{ form.error }}</p>
{%- endif %}
{%- if form.similar.size > 0 %}
<section aria-labelledby="similar-title" class="mt-8 overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default">
<h2 id="similar-title" class="border-b border-separator-border bg-background-secondary-default px-4 py-2.5 text-body-2-semibold">{{ 'similar_ideas' | t }}</h2>
<ul>
{%- for idea in form.similar %}
{% render 'idea_row', idea: idea %}
{%- endfor %}
</ul>
</section>
{%- endif %}
<form method="post" action="{{ help_center.feedback_url }}" class="mt-8 flex flex-col gap-5">
{{ form_token_field }}
{%- if form.similar.size > 0 %}<input type="hidden" name="sure" value="1">{% endif %}
{%- if form.boards.size > 1 %}
<label class="flex flex-col gap-1.5">
<span class="text-body-medium">{{ 'board' | t }}</span>
<select name="board" class="h-10 rounded-xl border border-border-button-default bg-background-primary-default px-3 text-body-regular shadow-xs outline-none transition hover:border-border-button-hover focus:border-border-button-hover focus:ring-4 focus:ring-tint">
{%- for b in form.boards %}
<option value="{{ b.slug }}"{% if b.slug == form.board %} selected{% endif %}>{{ b.name }}</option>
{%- endfor %}
</select>
</label>
{%- elsif form.board != "" %}
<input type="hidden" name="board" value="{{ form.board }}">
{%- endif %}
<label class="flex flex-col gap-1.5">
<span class="text-body-medium">{{ 'idea_title' | t }}</span>
<input type="text" name="title" value="{{ form.title }}" required maxlength="150" placeholder="{{ 'idea_title_placeholder' | t }}" class="h-10 rounded-xl border border-border-button-default bg-background-primary-default px-3 text-body-regular shadow-xs outline-none transition placeholder:text-text-placeholder hover:border-border-button-hover focus:border-border-button-hover focus:ring-4 focus:ring-tint">
</label>
<label class="flex flex-col gap-1.5">
<span class="text-body-medium">{{ 'idea_details' | t }}</span>
<textarea name="details" rows="6" placeholder="{{ 'idea_details_placeholder' | t }}" class="rounded-xl border border-border-button-default bg-background-primary-default px-3 py-2.5 text-body-regular shadow-xs outline-none transition placeholder:text-text-placeholder hover:border-border-button-hover focus:border-border-button-hover focus:ring-4 focus:ring-tint">{{ form.details }}</textarea>
</label>
<div class="flex items-center gap-3">
<button type="submit" class="button-brand inline-flex h-10 cursor-pointer items-center rounded-xl px-4 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">{% if form.similar.size > 0 %}{{ 'post_anyway' | t }}{% else %}{{ 'submit_idea' | t }}{% endif %}</button>
<a href="{{ help_center.feedback_url }}" class="text-body-medium text-text-secondary hover:text-text-primary">{{ 'cancel' | t }}</a>
</div>
</form>
</div>
