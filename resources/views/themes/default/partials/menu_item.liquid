{%- comment -%}A row of the copy menu: `title` and `detail` are words to translate; `label` is text already written.{%- endcomment -%}
<a href="{{ url }}" class="flex items-start gap-2.5 rounded-lg px-2.5 py-2 transition-colors hover:bg-background-secondary-hover" data-turbo="false">{{ icon | icon: 'mt-0.5 size-4 shrink-0 text-foreground-icon-secondary' }}<span><span class="block text-body-2-medium text-text-primary">{% if label %}{{ label }}{% else %}{{ title | t }}{% endif %}</span><span class="block text-caption-1-regular text-text-tertiary">{{ detail | t }}</span></span></a>
