{%- comment -%}A sidebar link to `url`, marked when `current`, with an optional `icon` or colored `dot` and a `count`.{%- endcomment -%}
<a href="{{ url }}"{% if current %} aria-current="page"{% endif %} class="flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:bg-background-secondary-default aria-[current=page]:text-text-primary">{% if icon %}{{ icon | icon: 'size-4 shrink-0 opacity-80' }}{% endif %}{% if dot %}<svg viewBox="0 0 8 8" width="8" height="8" class="size-2 shrink-0" aria-hidden="true"><circle cx="4" cy="4" r="4" fill="{{ dot }}"></circle></svg>{% endif %}<span class="flex-1 truncate">{{ title }}</span>{% if count > 0 %}<span class="text-caption-1-medium tabular-nums text-text-tertiary">{{ count }}</span>{% endif %}</a>
