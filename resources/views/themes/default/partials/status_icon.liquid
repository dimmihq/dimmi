{%- comment -%}
  A status as a ring that fills as requests move along: open while under
  consideration, dashed when planned, half full in progress, full once
  shipped and crossed out when closed.
{%- endcomment -%}
<svg viewBox="0 0 16 16" width="14" height="14" class="size-3.5 shrink-0" fill="none" stroke="{{ status.color }}" stroke-width="1.6" aria-hidden="true">
{%- case status.slug -%}
{%- when "planned" -%}<circle cx="8" cy="8" r="6.2" stroke-dasharray="2.4 2"></circle>
{%- when "in-progress" -%}<circle cx="8" cy="8" r="6.2"></circle><path d="M8 3.6a4.4 4.4 0 0 1 0 8.8Z" fill="{{ status.color }}" stroke="none"></path>
{%- when "shipped" -%}<circle cx="8" cy="8" r="6.2" fill="{{ status.color }}"></circle><path d="m5.4 8.2 1.8 1.8 3.4-3.6" stroke="white"></path>
{%- when "closed" -%}<circle cx="8" cy="8" r="6.2"></circle><path d="m5.8 5.8 4.4 4.4M10.2 5.8l-4.4 4.4"></path>
{%- else -%}<circle cx="8" cy="8" r="6.2"></circle>
{%- endcase -%}
</svg>
