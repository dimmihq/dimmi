{%- comment -%}A thread of messages; the reader's own sit at the end edge in the brand's color.{%- endcomment -%}
<ol class="{{ class }} flex flex-col gap-6 animate-rise">
{%- for m in messages %}
<li class="flex gap-3 {% if m.mine %}justify-end{% endif %}">{% unless m.mine %}{% render 'avatar', person: m.author, size: 'size-8 text-caption-1-semibold' %}{% endunless %}<div class="flex max-w-[80%] flex-col gap-1 {% if m.mine %}items-end{% endif %}"><p class="text-caption-1-regular text-text-tertiary">{{ m.author.name }} · {{ m.at }}</p><div class="{{ bubble }}rounded-2xl px-4 py-2.5 text-body-regular {% if m.mine %}button-brand rounded-ee-md{% else %}bg-background-secondary-default text-text-primary rounded-es-md{% endif %}">{{ m.body }}</div></div></li>
{%- endfor %}
</ol>
