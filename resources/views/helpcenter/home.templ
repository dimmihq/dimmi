package helpcenter

import "strconv"

/*
Home is the help center's front page, one calm column: the logo and
the help center's name, a greeting, one box to ask anything, then the
collections in their groups. Each collection opens in place to list its articles, so a
reader reaches any answer without leaving the page. The latest changes
close it.
*/

templ Home(c Center, collections []Collection, popular []Summary, updates []Update, assets templ.Component) {
	@Layout(c, Meta{Title: c.Name, Description: c.Tagline, Section: "help", Trail: []Crumb{{Title: "Help center", Path: "/"}}, Markdown: "/index.md"}, HelpSidebar(c, collections, "", ""), assets) {
		<div class="mx-auto w-full max-w-[42rem] px-5 pt-14 md:pt-20">
			<header class="stagger">
				<div class="flex items-center gap-3 [&_img]:h-9 [&>span:first-child]:size-10 [&>span:first-child]:text-title-3-semibold">
					@Logo(c)
				</div>
				<h1 class="mt-5 text-title-1-medium tracking-tight">
					<span data-greeting>Hi there.</span>
					<span class="text-text-tertiary">How can we help?</span>
				</h1>
				if c.Tagline != "" {
					<p class="mt-1 text-body-regular text-text-secondary">{ c.Tagline }</p>
				}
				<div class="mt-6">
					@AskBox(c, "", popular)
				</div>
			</header>
			<div class="stagger mt-10 flex flex-col gap-8">
				for _, col := range collections {
					@CollectionGroup(c, col, "", "")
				}
			</div>
			if len(updates) > 0 {
				<div class="mt-14">
					@latestUpdates(c, updates)
				</div>
			}
		</div>
	}
}

/*
CollectionGroup is a collection as a group: its name over a card of
rows, one for each collection inside it, which opens to list its
articles, and one for each article it holds itself. The collection
holding the page being read starts open, with that article marked.
*/

templ CollectionGroup(c Center, col Collection, current, article string) {
	if len(col.Children) > 0 || len(col.Articles) > 0 {
		<section aria-label={ col.Title }>
			<h2 class="px-1 pb-2 text-caption-1-medium text-text-tertiary">
				<a href={ Href(c, "/collections/"+col.Slug) } class="hover:text-text-primary">{ col.Title }</a>
			</h2>
			<div class="overflow-hidden rounded-xl border border-border-button-default bg-background-primary-default">
				for _, sub := range col.Children {
					@collectionRow(c, sub, current, article)
				}
				for _, a := range col.Articles {
					@articleRow(c, a, a.Slug == article)
				}
			</div>
		</section>
	}
}

templ collectionRow(c Center, col Collection, current, article string) {
	<details data-accordion class="group/row border-separator-border [&+*]:border-t" open?={ holds(col, current) }>
		<summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-2.5 text-body-medium outline-none transition-colors hover:bg-background-secondary-hover focus-visible:bg-background-secondary-hover">
			<span class="min-w-0 flex-1 truncate">{ col.Title }</span>
			<span class="text-caption-1-medium tabular-nums text-text-tertiary">{ strconv.Itoa(col.Count) }</span>
			@Icon("chevron-right", "size-4 shrink-0 text-foreground-icon-tertiary transition-transform group-open/row:rotate-90 rtl:-scale-x-100")
		</summary>
		<ul data-accordion-body class="overflow-hidden pb-2">
			for _, a := range col.Articles {
				<li>
					<a
						href={ Href(c, "/articles/"+a.Slug) }
						if a.Slug == article {
							aria-current="page"
						}
						class="mx-2 block rounded-lg px-3.5 py-1.5 text-body-2-regular text-text-secondary transition-colors hover:bg-background-secondary-hover hover:text-text-primary aria-[current=page]:bg-background-secondary-default aria-[current=page]:text-text-primary"
					>{ a.Title }</a>
				</li>
			}
			for _, sub := range col.Children {
				<li>
					<a href={ Href(c, "/collections/"+sub.Slug) } class="mx-2 flex items-center gap-2 rounded-lg px-3.5 py-1.5 text-body-2-medium text-text-secondary hover:bg-background-secondary-hover hover:text-text-primary">
						@Icon("book", "size-3.5 text-foreground-icon-tertiary")
						{ sub.Title }
					</a>
				</li>
			}
		</ul>
	</details>
}

templ articleRow(c Center, a Summary, current bool) {
	<a
		href={ Href(c, "/articles/"+a.Slug) }
		if current {
			aria-current="page"
		}
		class="flex items-center gap-3 border-separator-border px-4 py-2.5 text-body-medium outline-none transition-colors hover:bg-background-secondary-hover focus-visible:bg-background-secondary-hover aria-[current=page]:bg-background-secondary-default [&+*]:border-t"
	>
		<span class="min-w-0 flex-1 truncate">{ a.Title }</span>
	</a>
}

/*
AskBox is the one box the portal asks questions in. It searches the
articles today; suggested questions sit under it.
*/

templ AskBox(c Center, query string, suggestions []Summary) {
	<form action={ Href(c, "/search") } method="get" role="search" class="overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default shadow-sm transition focus-within:border-border-button-hover focus-within:ring-4 focus-within:ring-tint">
		<label class="flex h-14 items-center gap-3 ps-4 pe-2.5">
			@Icon("sparkle", "size-5 shrink-0 text-link")
			<span class="sr-only">Ask a question or search the help center</span>
			<input type="search" name="q" value={ query } placeholder="Ask anything…" autocomplete="off" class="h-full min-w-0 flex-1 bg-transparent text-headline-regular text-text-primary outline-none placeholder:text-text-placeholder"/>
			<button type="submit" aria-label="Ask" class="button-brand grid size-9 shrink-0 cursor-pointer place-items-center rounded-full outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">
				@Icon("arrow-up", "size-4")
			</button>
		</label>
		if len(suggestions) > 0 {
			<div class="flex flex-wrap items-center gap-x-1 gap-y-1 border-t border-separator-border bg-background-secondary-default px-2.5 py-2">
				for _, a := range suggestions[:min(3, len(suggestions))] {
					<a href={ Href(c, "/articles/"+a.Slug) } class="rounded-lg px-1.5 py-1 text-body-2-regular text-text-secondary transition-colors hover:bg-background-secondary-hover hover:text-text-primary">{ a.Title }</a>
				}
			</div>
		}
	</form>
}

templ latestUpdates(c Center, updates []Update) {
	<section aria-labelledby="updates">
		<div class="flex items-baseline justify-between">
			<h2 id="updates" class="text-body-medium text-text-secondary">Latest updates</h2>
			<a href={ Href(c, "/changelog") } class="text-body-2-medium text-link hover:underline">Changelog</a>
		</div>
		<ol class="relative ms-1 mt-5 border-s border-separator-border">
			for _, u := range updates {
				<li class="relative pb-6 ps-5 last:pb-0">
					<span class="absolute -start-[5px] top-1.5 size-[9px] rounded-full bg-brand ring-4 ring-background-full" aria-hidden="true"></span>
					<p class="text-caption-1-regular text-text-tertiary">
						<time datetime={ Stamp(u.Published) }>{ Day(u.Published) }</time>
						if u.Label != "" {
							· { u.Label }
						}
					</p>
					<a href={ Href(c, u.Path) } class="mt-1 block text-body-medium text-text-primary hover:text-link">{ u.Title }</a>
				</li>
			}
		</ol>
	</section>
}

/*
HelpSidebar is what the browse drawer lists on help pages: every
collection as a group, the one holding the page open.
*/

templ HelpSidebar(c Center, all []Collection, current, article string) {
	<nav aria-label="Collections" class="flex flex-col gap-5">
		for _, col := range all {
			@CollectionGroup(c, col, current, article)
		}
	</nav>
}
