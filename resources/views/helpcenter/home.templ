package helpcenter

/*
Home is the help center's front page. It greets the visitor and leads
with one box to ask anything, which answers from the articles, then the
collections as cards, the articles most read this week and the latest
changes.
*/

templ Home(c Center, collections []Collection, popular []Summary, updates []Update, assets templ.Component) {
	@Layout(c, Meta{Title: c.Name, Description: c.Tagline, Section: "help", Trail: []Crumb{{Title: "Help center", Path: "/"}}, Markdown: "/index.md"}, HelpSidebar(c, collections, "", ""), assets) {
		<div class="mx-auto w-full max-w-[52rem] px-5 pt-14 md:pt-24">
			<div class="stagger">
				<h1 class="text-display-4-medium tracking-tight text-balance">
					<span data-greeting>Hi there.</span>
					<span class="text-text-tertiary">How can we help?</span>
				</h1>
				<div class="mt-7">
					@AskBox(c, "", popular)
				</div>
			</div>
			<section aria-labelledby="collections" class="mt-16">
				<h2 id="collections" class="text-body-medium text-text-secondary">Collections</h2>
				<ul class="stagger mt-4 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
					for _, col := range collections {
						<li class="flex">
							@collectionCard(c, col)
						</li>
					}
				</ul>
			</section>
			<div class="mt-16 grid gap-10 md:grid-cols-[minmax(0,1fr)_17rem]">
				<section aria-labelledby="trending">
					<h2 id="trending" class="text-body-medium text-text-secondary">Trending articles</h2>
					<div class="mt-4">
						@ArticleList(c, popular, true)
					</div>
				</section>
				if len(updates) > 0 {
					@latestUpdates(c, updates)
				}
			</div>
		</div>
	}
}

/*
AskBox is the one box the portal asks questions in. It searches the
articles today; suggested questions sit under it.
*/

templ AskBox(c Center, query string, suggestions []Summary) {
	<form action={ Href(c, "/search") } method="get" role="search" class="overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default shadow-sm transition focus-within:border-border-button-hover focus-within:ring-4 focus-within:ring-tint">
		<label class="flex h-14 items-center gap-3 ps-4 pe-2.5">
			@Icon("sparkle", "size-5 shrink-0 text-link")
			<span class="sr-only">Ask a question or search the help center</span>
			<input type="search" name="q" value={ query } placeholder="Ask anything…" autocomplete="off" class="h-full min-w-0 flex-1 bg-transparent text-headline-regular text-text-primary outline-none placeholder:text-text-placeholder"/>
			<button type="submit" aria-label="Ask" class="button-brand grid size-9 shrink-0 cursor-pointer place-items-center rounded-full outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">
				@Icon("arrow-up", "size-4")
			</button>
		</label>
		if len(suggestions) > 0 {
			<div class="flex flex-wrap items-center gap-x-1 gap-y-1 border-t border-separator-border bg-background-secondary-default px-2.5 py-2">
				for _, a := range suggestions[:min(3, len(suggestions))] {
					<a href={ Href(c, "/articles/"+a.Slug) } class="rounded-lg px-1.5 py-1 text-body-2-regular text-text-secondary transition-colors hover:bg-background-secondary-hover hover:text-text-primary">{ a.Title }</a>
				}
			</div>
		}
	</form>
}

templ collectionCard(c Center, col Collection) {
	<a href={ Href(c, "/collections/"+col.Slug) } class="group flex w-full flex-col overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default outline-none transition duration-200 hover:border-border-button-hover hover:shadow-md focus-visible:ring-2 focus-visible:ring-border-focus-ring">
		<span class="dot-grid relative flex h-24 items-start border-b border-separator-border bg-background-secondary-default p-4 transition-colors group-hover:bg-tint">
			<span class="grid size-9 place-items-center rounded-xl border border-border-button-default bg-background-primary-default text-link shadow-xs">
				@Icon(col.Icon, "size-[1.125rem]")
			</span>
			<span class="absolute bottom-3 end-4 text-caption-1-medium text-text-tertiary">{ Plural(col.Count, "article") }</span>
		</span>
		<span class="flex flex-1 flex-col p-4">
			<span class="text-body-semibold text-text-primary">{ col.Title }</span>
			<span class="mt-1 text-body-2-regular text-text-secondary">{ col.Description }</span>
		</span>
	</a>
}

/*
ArticleList is a list of articles grouped in one card, each a row with
its title and, when the list mixes collections, where it lives.
*/

templ ArticleList(c Center, articles []Summary, showCollection bool) {
	<ul class="overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default">
		for _, a := range articles {
			<li class="border-separator-border [&+&]:border-t">
				<a href={ Href(c, "/articles/"+a.Slug) } class="group flex items-center gap-3 px-4 py-3 outline-none transition-colors hover:bg-background-secondary-hover focus-visible:bg-background-secondary-hover">
					@Icon("file", "size-4 shrink-0 text-foreground-icon-tertiary")
					<span class="min-w-0 flex-1">
						<span class="block truncate text-body-medium text-text-primary">{ a.Title }</span>
						if showCollection {
							<span class="block truncate text-body-2-regular text-text-tertiary">{ a.Collection }</span>
						}
					</span>
					@Icon("chevron-right", "size-4 shrink-0 text-foreground-icon-quaternary transition group-hover:translate-x-0.5 group-hover:text-foreground-icon-secondary rtl:-scale-x-100")
				</a>
			</li>
		}
	</ul>
}

templ latestUpdates(c Center, updates []Update) {
	<section aria-labelledby="updates">
		<div class="flex items-baseline justify-between">
			<h2 id="updates" class="text-body-medium text-text-secondary">Latest updates</h2>
			<a href={ Href(c, "/changelog") } class="text-body-2-medium text-link hover:underline">Changelog</a>
		</div>
		<ol class="relative ms-1 mt-5 border-s border-separator-border">
			for _, u := range updates {
				<li class="relative pb-6 ps-5 last:pb-0">
					<span class="absolute -start-[5px] top-1.5 size-[9px] rounded-full bg-brand ring-4 ring-background-full" aria-hidden="true"></span>
					<p class="text-caption-1-regular text-text-tertiary">
						<time datetime={ Stamp(u.Published) }>{ Day(u.Published) }</time>
						if u.Label != "" {
							· { u.Label }
						}
					</p>
					<a href={ Href(c, u.Path) } class="mt-1 block text-body-medium text-text-primary hover:text-link">{ u.Title }</a>
				</li>
			}
		</ol>
	</section>
}

/*
HelpSidebar lists every collection. The current one opens to show its
articles, with the current article marked among them.
*/

templ HelpSidebar(c Center, all []Collection, current, article string) {
	<nav aria-label="Collections" class="flex flex-col gap-0.5">
		@SidebarHeading("Collections")
		for _, col := range all {
			@helpSidebarItem(c, col, current, article)
		}
	</nav>
}

templ helpSidebarItem(c Center, col Collection, current, article string) {
	<a
		href={ Href(c, "/collections/"+col.Slug) }
		if col.Slug == current && article == "" {
			aria-current="page"
		}
		class="group flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:bg-background-secondary-default aria-[current=page]:text-text-primary"
	>
		@Icon(col.Icon, "size-4 shrink-0 opacity-80")
		<span class="flex-1 truncate">{ col.Title }</span>
		if holds(col, current) {
			@Icon("chevron-down", "size-4 shrink-0 text-foreground-icon-tertiary")
		} else {
			@Icon("chevron-right", "size-4 shrink-0 text-foreground-icon-quaternary opacity-0 transition group-hover:opacity-100 rtl:-scale-x-100")
		}
	</a>
	if holds(col, current) {
		<div class="mb-1.5 ms-[1.1875rem] flex flex-col border-s border-separator-border ps-2">
			for _, a := range col.Articles {
				<a
					href={ Href(c, "/articles/"+a.Slug) }
					if a.Slug == article {
						aria-current="page"
					}
					class="relative rounded-md px-2.5 py-1 text-body-2-regular text-text-secondary transition-colors hover:text-text-primary aria-[current=page]:font-medium aria-[current=page]:text-text-primary aria-[current=page]:before:absolute aria-[current=page]:before:-start-[9px] aria-[current=page]:before:inset-y-1 aria-[current=page]:before:w-px aria-[current=page]:before:bg-brand"
				>{ a.Title }</a>
			}
			for _, sub := range col.Children {
				@helpSidebarItem(c, sub, current, article)
			}
		</div>
	}
}
