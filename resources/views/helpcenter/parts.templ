package helpcenter

import "net/url"

/*
copyMenu copies the article's Markdown, for pasting into an AI chat or
an editor, and opens a menu to view the Markdown or ask ChatGPT or
Claude about the page. Copying needs the script; the menu does not.
*/

templ copyMenu(c Center, a Article) {
	<div class="flex shrink-0 rounded-xl border border-border-button-default bg-background-primary-default shadow-xs">
		<button type="button" data-copy={ Path(c, "/articles/"+a.Slug+".md") } class="inline-flex h-8 cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-s-xl px-2.5 text-body-2-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring">
			@Icon("copy", "size-3.5")
			<span data-copy-label>Copy page</span>
		</button>
		<details data-menu class="group relative border-s border-border-button-default">
			<summary aria-label="More ways to use this page" class="grid h-8 w-8 cursor-pointer list-none place-items-center rounded-e-xl text-foreground-icon-secondary transition-colors hover:bg-background-secondary-hover">
				@Icon("chevron-down", "size-4 transition group-open:rotate-180")
			</summary>
			<div class="absolute end-0 top-10 z-20 w-64 rounded-xl border border-border-button-default bg-background-primary-default p-1 shadow-lg">
				@menuItem(Href(c, "/articles/"+a.Slug+".md"), "markdown", "View as Markdown", "Plain text for people and agents")
				@menuItem(askURL("https://chatgpt.com/?hints=search&q=", c, a), "openai", "Open in ChatGPT", "Ask questions about this page")
				@menuItem(askURL("https://claude.ai/new?q=", c, a), "claude", "Open in Claude", "Ask questions about this page")
			</div>
		</details>
	</div>
}

templ menuItem(href templ.SafeURL, icon, title, detail string) {
	<a href={ href } class="flex items-start gap-2.5 rounded-lg px-2.5 py-2 transition-colors hover:bg-background-secondary-hover" data-turbo="false">
		@Icon(icon, "mt-0.5 size-4 shrink-0 text-foreground-icon-secondary")
		<span>
			<span class="block text-body-2-medium text-text-primary">{ title }</span>
			<span class="block text-caption-1-regular text-text-tertiary">{ detail }</span>
		</span>
	</a>
}

/*
askURL opens an AI chat asking it to read the article's Markdown.
*/
func askURL(chat string, c Center, a Article) templ.SafeURL {
	page := c.Origin + Path(c, "/articles/"+a.Slug+".md")

	return templ.SafeURL(chat + url.QueryEscape("Read "+page+" so I can ask questions about it."))
}

/*
contents lists an article's headings beside it, staying in view while
the article scrolls on wide screens. The portal's script marks the
heading being read as the article scrolls.
*/

templ contents(headings []Heading) {
	<nav aria-labelledby="contents" data-contents>
		<div>
			<p id="contents" class="text-caption-1-medium text-text-tertiary">In this article</p>
			<ul class="mt-3 flex flex-col border-s border-separator-border">
				for _, h := range headings {
					@contentsItem(h, "ps-3")
					for _, sub := range h.Children {
						@contentsItem(sub, "ps-6")
					}
				}
			</ul>
		</div>
	</nav>
}

templ contentsItem(h Heading, indent string) {
	<li>
		<a href={ templ.SafeURL("#" + h.ID) } class={ "-ms-px block border-s border-transparent py-1 text-body-2-regular text-text-secondary transition-colors hover:border-border-button-hover hover:text-text-primary aria-[current=location]:border-brand aria-[current=location]:text-text-primary " + indent }>{ h.Title }</a>
	</li>
}

/*
feedback asks whether the article helped, with two buttons that post a
plain form. A yes is thanked. A no asks what the reader was looking for,
in a box they can leave empty, with a way to a person beside it; once
they write, the team reads it beside the article.
*/

templ feedback(c Center, slug string, h Helpful) {
	<section id="feedback" class="mt-14 rounded-2xl border border-border-button-default bg-background-secondary-default px-5 py-4">
		switch  {
			case h.Answer == "":
				<div class="flex flex-wrap items-center gap-4">
					<h2 class="text-body-medium">Was this article helpful?</h2>
					<form method="post" action={ Href(c, "/articles/"+slug+"/feedback") } class="ms-auto flex gap-2">
						@feedbackButton("yes", "thumb-up", "Yes")
						@feedbackButton("no", "thumb-down", "No")
					</form>
				</div>
			case h.Answer == "yes":
				@feedbackThanks("Thanks for letting us know.")
			case h.Commented:
				<div class="flex flex-wrap items-center gap-4">
					@feedbackThanks("Thanks. The team reads every note and will improve this article.")
					@HelpButton(c, "ms-auto text-body-medium text-link hover:underline", "", "")
				</div>
			default:
				@missingForm(c, slug, h)
		}
	</section>
}

templ feedbackThanks(text string) {
	<p class="flex items-center gap-3 text-body-medium">
		<span class="grid size-8 shrink-0 place-items-center rounded-full bg-tint text-link">
			@Icon("check", "size-4")
		</span>
		{ text }
	</p>
}

/*
missingForm asks a reader who said no what they were looking for.
*/

templ missingForm(c Center, slug string, h Helpful) {
	<form method="post" action={ Href(c, "/articles/"+slug+"/feedback/comment") } class="flex flex-col gap-3">
		<label for="feedback-comment" class="text-body-medium">Sorry about that. What were you looking for?</label>
		if h.Limited {
			<p role="alert" class="text-body-2-regular text-text-error-primary">You've sent a lot of feedback. Try again in a little while.</p>
		}
		<textarea id="feedback-comment" name="comment" rows="3" required maxlength="2000" placeholder="Tell us what was missing or unclear" class="rounded-xl border border-border-button-default bg-background-primary-default px-3 py-2.5 text-body-regular shadow-xs outline-none transition placeholder:text-text-placeholder hover:border-border-button-hover focus:border-border-button-hover focus:ring-4 focus:ring-tint"></textarea>
		<div class="flex flex-wrap items-center gap-3">
			<button type="submit" class="button-brand inline-flex h-9 cursor-pointer items-center rounded-xl px-4 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">Send feedback</button>
			@HelpButton(c, "ms-auto text-body-medium text-link hover:underline", "Or ", "")
		</div>
	</form>
}

templ feedbackButton(value, icon, label string) {
	<button type="submit" name="helpful" value={ value } class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-xl border border-border-button-default bg-background-primary-default px-3.5 text-body-medium text-text-secondary shadow-xs outline-none transition hover:border-border-button-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring active:scale-[0.98]">
		@Icon(icon, "size-4")
		{ label }
	</button>
}

/*
neighbors links the articles before and after this one in its
collection.
*/

templ neighbors(c Center, previous, next *Summary) {
	if previous != nil || next != nil {
		<nav aria-label="More in this collection" class="mt-6 grid gap-3 sm:grid-cols-2">
			if previous != nil {
				@neighbor(c, *previous, "Previous", "")
			} else {
				<span></span>
			}
			if next != nil {
				@neighbor(c, *next, "Next", "sm:items-end sm:text-end")
			}
		</nav>
	}
}

templ neighbor(c Center, a Summary, label, align string) {
	<a href={ Href(c, "/articles/"+a.Slug) } class={ "group flex flex-col rounded-2xl border border-border-button-default p-4 outline-none transition hover:border-border-button-hover hover:bg-background-secondary-hover focus-visible:ring-2 focus-visible:ring-border-focus-ring " + align }>
		<span class="flex items-center gap-1 text-caption-1-medium text-text-tertiary">
			if label == "Previous" {
				@Icon("arrow-left", "size-3.5 rtl:-scale-x-100")
			}
			{ label }
			if label == "Next" {
				@Icon("arrow-right", "size-3.5 rtl:-scale-x-100")
			}
		</span>
		<span class="mt-1 text-body-medium text-text-primary">{ a.Title }</span>
	</a>
}

/*
holds says whether the collection is the current one or one of its
sub-collections is.
*/
func holds(col Collection, current string) bool {
	if col.Slug == current {
		return true
	}

	for _, sub := range col.Children {
		if holds(sub, current) {
			return true
		}
	}

	return false
}

/*
helpTrail is the top bar's trail to a help page: the help center, the
collections leading to it, and the page's own title.
*/
func helpTrail(trail []Crumb, collection, page string) []Crumb {
	out := append([]Crumb{{Title: "Help center", Path: "/"}}, trail...)
	if collection != "" {
		out = append(out, Crumb{Title: collection, Path: "/"})
	}

	if page != "" {
		out = append(out, Crumb{Title: page, Path: "/"})
	}

	return out
}

/*
collectionBySlug finds the collection with the slug at any depth.
*/
func collectionBySlug(all []Collection, slug string) (Collection, bool) {
	for _, col := range all {
		if col.Slug == slug {
			return col, true
		}
		if found, ok := collectionBySlug(col.Children, slug); ok {
			return found, true
		}
	}
	return Collection{}, false
}

func trailEnd(trail []Crumb) string {
	if len(trail) == 0 {
		return ""
	}

	last := trail[len(trail)-1].Path

	return last[len("/collections/"):]
}

func byline(people []Person) string {
	switch len(people) {
	case 0:
		return "By our team"
	case 1:
		return "By " + people[0].Name
	default:
		return "By " + people[0].Name + " and " + Plural(len(people)-1, "other")
	}
}

func searchTitle(query string) string {
	if query == "" {
		return "Search"
	}

	return "Search results for “" + query + "”"
}

func resultIcon(kind string) string {
	if kind == "changelog" {
		return "megaphone"
	}

	return "file"
}
