package helpcenter

/*
CollectionPage lists a collection: the way back home, its name and who
writes it, then the collections inside it, each opening in place to
list its articles, and its own articles.
*/

templ CollectionPage(c Center, all []Collection, col Collection, trail []Crumb, assets templ.Component) {
	@Layout(c, Meta{Title: col.Title + " | " + c.Name, Description: col.Description, Section: "help", Trail: helpTrail(c, trail, col.Title, ""), Markdown: "/collections/" + col.Slug + ".md"}, HelpSidebar(c, all, col.Slug, ""), assets) {
		<div class="stagger mx-auto w-full max-w-[42rem] px-5 pt-10 md:pt-14">
			@Breadcrumb(c, helpTrail(c, trail, col.Title, ""))
			<header class="mt-5">
				<h1 class="text-title-1-medium tracking-tight">{ col.Title }</h1>
				if col.Description != "" {
					<p class="mt-2 text-body-regular text-text-secondary">{ col.Description }</p>
				}
				<p class="mt-4 flex items-center gap-2.5 text-body-2-regular text-text-tertiary">
					if len(col.Authors) > 0 {
						@Avatars(col.Authors)
					}
					{ byline(c, col.Authors) } · { c.T("article_count", "count", col.Count) }
				</p>
			</header>
			<div class="mt-8">
				@CollectionGroup(c, Collection{Slug: col.Slug, Title: c.T("in_this_collection"), Children: col.Children, Articles: col.Articles}, "", "")
			</div>
		</div>
	}
}

/*
ArticlePage shows an article: the way back to its collection, its title
and summary, a menu to take its Markdown elsewhere, who wrote it and
when it last changed, the body, whether it helped and the articles
before and after it. Beside it on wide screens sit its contents and the
other articles of its collection.
*/

templ ArticlePage(c Center, all []Collection, a Article, helpful Helpful, assets templ.Component) {
	@Layout(c, Meta{Title: a.Title + " | " + c.Name, Description: a.Description, Section: "help", Trail: helpTrail(c, a.Trail, "", a.Title), Markdown: "/articles/" + a.Slug + ".md", NoIndex: a.Untranslated != ""}, HelpSidebar(c, all, trailEnd(a.Trail), a.Slug), assets) {
		<div class="mx-auto grid w-full max-w-[66rem] gap-14 px-5 pt-10 md:pt-14 xl:grid-cols-[minmax(0,1fr)_15rem]">
			<article class="min-w-0 w-full max-w-[42.5rem] animate-rise max-xl:mx-auto">
				if a.Untranslated != "" {
					<p data-untranslated class="mb-5 flex items-start gap-2.5 rounded-xl border border-border-button-default bg-background-secondary-default px-3.5 py-2.5 text-body-2-regular text-text-secondary">
						@Icon("globe", "mt-0.5 size-4 shrink-0 text-foreground-icon-tertiary")
						<span>{ c.T("untranslated", "language", a.Untranslated) }</span>
					</p>
				}
				@Breadcrumb(c, helpTrail(c, a.Trail, "", ""))
				<div class="mt-5 flex items-start justify-between gap-6">
					<h1 class="min-w-0 flex-1 text-display-4-medium tracking-tight text-balance" { originalLang(a)... }>{ a.Title }</h1>
					<div class="pt-1.5 max-sm:hidden">
						@copyMenu(c, a)
					</div>
				</div>
				if a.Description != "" {
					<p class="mt-3 text-title-3-regular text-text-secondary">{ a.Description }</p>
				}
				<p class="mt-4 flex flex-wrap items-center gap-2 text-body-2-regular text-text-tertiary">
					<time datetime={ Stamp(a.Updated) }>{ updatedLine(c, a) }</time>
					<span aria-hidden="true">·</span>
					<span>{ c.T("reading_time", "count", a.Minutes) }</span>
				</p>
				<div class="prose mt-8" { originalLang(a)... }>
					@templ.Raw(a.Body)
				</div>
				@feedback(c, a.Slug, helpful)
				@neighbors(c, a.Previous, a.Next)
			</article>
			<aside class="flex flex-col gap-8 max-xl:hidden">
				<div data-rail class="sticky top-24 flex max-h-[calc(100dvh-8rem)] flex-col gap-8 overflow-y-auto overscroll-contain pb-8 [mask-image:linear-gradient(to_bottom,black_calc(100%-3rem),transparent)] [scrollbar-width:none]">
					if len(a.Contents) > 0 {
						@contents(c, a.Contents)
					}
					@siblings(c, all, a)
				</div>
			</aside>
		</div>
	}
}

/*
siblings lists the other articles of the article's collection.
*/

templ siblings(c Center, all []Collection, a Article) {
	if col, ok := collectionBySlug(all, trailEnd(a.Trail)); ok && len(col.Articles) > 1 {
		<nav aria-label={ c.T("in_collection", "name", col.Title) }>
			<p class="text-caption-1-medium text-text-tertiary">{ c.T("in_collection", "name", col.Title) }</p>
			<ul class="mt-3 flex flex-col gap-2">
				for _, s := range col.Articles {
					if s.Slug != a.Slug {
						<li><a href={ Href(c, "/articles/"+s.Slug) } class="block text-body-2-regular text-text-secondary transition-colors hover:text-text-primary">{ s.Title }</a></li>
					}
				}
			</ul>
		</nav>
	}
}

/*
Breadcrumb is the way back from a page: home, then each step to it.
*/

templ Breadcrumb(c Center, crumbs []Crumb) {
	<nav aria-label={ c.T("breadcrumb") }>
		<ol class="flex flex-wrap items-center gap-1.5 text-body-2-regular text-text-tertiary">
			for i, crumb := range crumbs {
				if i > 0 {
					<li aria-hidden="true">/</li>
				}
				<li class="flex">
					<a href={ Href(c, crumb.Path) } class="flex items-center gap-1 transition-colors hover:text-text-primary">
						if i == 0 {
							@Icon("arrow-left-line", "size-3.5 rtl:-scale-x-100")
							{ c.T("home") }
						} else {
							{ crumb.Title }
						}
					</a>
				</li>
			}
		</ol>
	</nav>
}

/*
SearchPage shows what a question found, each article with where it
lives and the text that matched.
*/

templ SearchPage(c Center, all []Collection, query string, results []Result, assets templ.Component) {
	@Layout(c, Meta{Title: searchTitle(c, query) + " | " + c.Name, Section: "help", Trail: []Crumb{{Title: c.T("help_center"), Path: "/"}, {Title: c.T("search"), Path: "/search"}}, NoIndex: true}, HelpSidebar(c, all, "", ""), assets) {
		<div class="mx-auto w-full max-w-[46rem] animate-rise px-5 pt-12 md:pt-16">
			@AskBox(c, query, nil)
			if query == "" {
				<p class="mt-8 text-body-regular text-text-secondary">{ c.T("search_hint") }</p>
			} else if len(results) == 0 {
				<div class="mt-8 rounded-2xl border border-dashed border-border-button-default px-6 py-12 text-center">
					<span class="mx-auto grid size-11 place-items-center rounded-2xl bg-background-secondary-default text-foreground-icon-tertiary">
						@Icon("search", "size-5")
					</span>
					<h1 class="mt-4 text-headline-semibold">{ c.T("no_answers", "query", query) }</h1>
					<p class="mt-1 text-body-regular text-text-secondary">
						if c.Messenger != "" {
							{ c.T("try_fewer_or_ask") }
						} else {
							{ c.T("try_fewer") }
						}
					</p>
					@HelpButton(c, "button-brand mt-5 inline-flex h-9 items-center gap-1.5 rounded-xl px-3.5 text-body-medium", "", "size-4")
				</div>
			} else {
				<h1 class="mt-8 text-body-regular text-text-secondary">
					{ c.T("results_match", "count", len(results)) } <span class="text-body-medium text-text-primary">“{ query }”</span>
				</h1>
				<ul class="mt-4 overflow-hidden rounded-2xl border border-border-button-default bg-background-primary-default">
					for _, r := range results {
						<li class="border-separator-border [&+&]:border-t">
							<a href={ Href(c, r.Path) } class="group block px-5 py-4 outline-none transition-colors hover:bg-background-secondary-hover focus-visible:bg-background-secondary-hover">
								<span class="flex items-center gap-1.5 text-caption-1-medium text-text-tertiary">
									@Icon(resultIcon(r.Kind), "size-3.5")
									{ r.Trail }
								</span>
								<span class="mt-1 block text-body-semibold text-text-primary">{ r.Title }</span>
								<span class="mt-1 line-clamp-2 block text-body-2-regular text-text-secondary">{ r.Excerpt }</span>
							</a>
						</li>
					}
				</ul>
			}
		</div>
	}
}

/*
NotFoundPage answers a path the portal has nothing at.
*/

templ NotFoundPage(c Center, all []Collection, popular []Summary, assets templ.Component) {
	@Layout(c, Meta{Title: c.T("page_not_found") + " | " + c.Name, Section: "help", Trail: []Crumb{{Title: c.T("help_center"), Path: "/"}, {Title: c.T("not_found"), Path: "/"}}, NoIndex: true}, HelpSidebar(c, all, "", ""), assets) {
		<div class="stagger mx-auto w-full max-w-[40rem] px-5 pt-20 text-center">
			<p class="text-body-medium text-link">404</p>
			<h1 class="mt-2 text-display-4-medium tracking-tight">{ c.T("not_found_title") }</h1>
			<p class="mt-3 text-title-3-regular text-text-secondary">{ c.T("not_found_body") }</p>
			<div class="mt-8 text-start">
				@AskBox(c, "", popular)
			</div>
		</div>
	}
}

/*
ReaderSignInPage takes a reader back from the team's product, or in from
the messenger: the identity token or the pass arrives in the address's
fragment, which the browser never sends, so the page's script copies it
into the form and sends it. Without scripts, the reader presses the
button.
*/

templ ReaderSignInPage(c Center, action string, next string, assets templ.Component) {
	@Layout(c, Meta{Title: c.T("signing_in") + " | " + c.Product, NoIndex: true}, templ.NopComponent, assets) {
		<div class="mx-auto flex max-w-md flex-col items-center py-24 text-center">
			<h1 class="text-title-2-medium tracking-tight">{ c.T("signing_you_in") }</h1>
			<p class="mt-2 text-body-regular text-text-secondary">{ c.T("one_moment", "product", c.Product) }</p>
			<form method="post" action={ templ.SafeURL(action) } data-help-sign-in class="mt-6">
				<input type="hidden" name="token" value=""/>
				<input type="hidden" name="pass" value=""/>
				<input type="hidden" name="next" value={ next }/>
				<button type="submit" class="button-brand inline-flex h-10 cursor-pointer items-center rounded-xl px-4 text-body-medium">{ c.T("continue") }</button>
			</form>
		</div>
	}
}

/*
originalLang marks an article shown in its default language, on a page
of another, with the language it is written in.
*/
func originalLang(a Article) templ.Attributes {
	if a.OriginalLang == "" {
		return nil
	}
	return templ.Attributes{"lang": a.OriginalLang}
}
