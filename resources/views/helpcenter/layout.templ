package helpcenter

import "strconv"

/*
Layout is the frame of every portal page: a top bar with the logo, the
portal's sections, the theme menu, a way to a person and the visitor's
sign-in; the page in one column; then the team's footer text, its
contact link and the dimmi mark. Where a section lists something to
browse, such as the help center's collections, a drawer slides in from
the start edge and pushes the page aside. Turbo Drive swaps pages in
place with a fade, fetching a link while the pointer rests on it;
without scripts every link and form still works. The theme check in the
head applies the theme before anything paints: the team's when it set
light or dark, else the reader's pick, else their system's. The tab
shows the company's logo, and with none the page names an empty icon
so browsers do not ask the server for one.
*/

templ Layout(c Center, m Meta, sidebar templ.Component, assets templ.Component) {
	<!DOCTYPE html>
	<html lang="en" style={ BrandStyle(c) } data-appearance={ fixedTheme(c) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ colorScheme(c) }/>
			<meta name="view-transition" content="same-origin"/>
			<meta name="turbo-cache-control" content="no-preview"/>
			<meta name="csp-nonce" content={ templ.GetNonce(ctx) }/>
			<title>{ m.Title }</title>
			if m.Description != "" {
				<meta name="description" content={ m.Description }/>
				<meta property="og:description" content={ m.Description }/>
			}
			<meta property="og:title" content={ m.Title }/>
			<meta property="og:site_name" content={ c.Name }/>
			<meta name="theme-color" content={ c.Brand }/>
			if c.LogoLight != "" {
				<link rel="icon" href={ Path(c, c.LogoLight) }/>
			} else {
				<link rel="icon" href="data:,"/>
			}
			if m.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if m.Markdown != "" {
				<link rel="alternate" type="text/markdown" href={ Href(c, m.Markdown) }/>
			}
			<link rel="alternate" type="application/rss+xml" title={ c.Product + " changelog" } href={ Href(c, "/changelog/feed.xml") }/>
			@applyTheme()
			@drawerStyle()
			@assets
			if c.Messenger != "" {
				<script async nonce={ templ.GetNonce(ctx) } src={ c.MessengerSrc } data-app-id={ c.Messenger }></script>
			}
		</head>
		<body class="bg-background-full font-inter text-text-primary">
			<a href="#main" class="sr-only rounded-xl bg-background-primary-default px-4 py-2 text-body-medium focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50">Skip to content</a>
			if hasDrawer(m) {
				@drawerPanel(c, m, sidebar)
			}
			<div data-page class="relative flex min-h-dvh min-w-0 flex-col">
				if hasDrawer(m) {
					<div data-drawer-backdrop aria-hidden="true" class="absolute inset-0 z-40"></div>
				}
				@topBar(c, m)
				<main id="main" class="flex-1 pb-24">
					{ children... }
				</main>
				<footer class="flex flex-col items-center gap-4 px-4 pb-8 text-center">
					if c.FooterText != "" || c.ContactURL != "" {
						<div class="flex max-w-[40rem] flex-col items-center gap-2 text-body-2-regular text-text-tertiary">
							if c.FooterText != "" {
								<p class="whitespace-pre-line">{ c.FooterText }</p>
							}
							if c.ContactURL != "" {
								<a href={ templ.SafeURL(c.ContactURL) } class="text-link hover:underline">Contact us</a>
							}
						</div>
					}
					<a href="https://trydimmi.com" class="inline-flex items-center gap-1.5 rounded-full border border-border-button-default px-2.5 py-1 text-caption-1-medium text-text-tertiary transition-colors hover:text-text-primary">
						<svg viewBox="4 4 40 40" width="12" height="12" class="size-3" fill="currentColor" aria-hidden="true">
							<path d="M4 24a20 20 0 0 1 13.7-19L43 30.3A20 20 0 0 1 24 44H11a7 7 0 0 1-7-7Z"></path>
							<path d="M19.8 4.5a20 20 0 0 1 4.9-.5L44 23.3a20 20 0 0 1-.5 4.9Z"></path>
							<path d="M27.6 4.3A20 20 0 0 1 35 7.3l5.7 5.7a20 20 0 0 1 3 7.4Z"></path>
						</svg>
						Powered by dimmi
					</a>
				</footer>
			</div>
		</body>
	</html>
}

/*
drawerStyle slides the browse drawer in from the start edge and pushes
the page aside by its width, then slides both back when it closes. It
sits in the head rather than the stylesheet so the drawer is closed
from the very first paint, before the stylesheet arrives. Nothing moves
for readers who ask for less motion.
*/

templ drawerStyle() {
	<style>
		:root { --drawer-width: min(20rem, 85vw); --drawer-ease: cubic-bezier(0.32, 0.72, 0, 1); }
		body { overflow-x: clip; }
		[data-drawer-panel] { inline-size: var(--drawer-width); translate: -100% 0; visibility: hidden; transition: translate 380ms var(--drawer-ease), visibility 0s linear 380ms; }
		[dir="rtl"] [data-drawer-panel] { translate: 100% 0; }
		[data-page] { transition: translate 380ms var(--drawer-ease); }
		[data-drawer-backdrop] { display: none; }
		html:has(details[data-drawer][open]) [data-drawer-panel] { translate: 0 0; visibility: visible; transition: translate 380ms var(--drawer-ease); }
		html:has(details[data-drawer][open]) [data-page] { translate: var(--drawer-width) 0; }
		html:has(details[data-drawer][open]) [data-drawer-backdrop] { display: block; cursor: pointer; }
		html[dir="rtl"]:has(details[data-drawer][open]) [data-page] { translate: calc(var(--drawer-width) * -1) 0; }
		@media (prefers-reduced-motion: reduce) { [data-drawer-panel], [data-page] { transition: none; } }
	</style>
}

/*
applyTheme sets the page's theme before it paints: the team's fixed
one, or the reader's pick kept in this browser, or their system's,
which it then keeps following.
*/

templ applyTheme() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => { const root = document.documentElement; const dark = matchMedia("(prefers-color-scheme: dark)"); const pick = () => { const fixed = root.dataset.appearance; if (fixed) return fixed; try { return localStorage.getItem("dimmi-portal-theme") || "system" } catch { return "system" } }; const apply = () => { const p = pick(); root.dataset.themePick = p; root.classList.toggle("dark", p === "dark" || (p === "system" && dark.matches)) }; apply(); dark.addEventListener("change", apply); window.dimmiTheme = apply })()
	</script>
}

/*
themeSwitch lets a reader pick light, dark or their system's theme from
a small menu, shown only where the team left the choice to readers. Its
button shows the current pick, which the page's head marks before the
first paint, so it never changes once the page loads.
*/

templ themeSwitch(c Center) {
	if fixedTheme(c) == "" {
		<details data-menu data-theme-switch class="relative">
			<summary aria-label="Theme" title="Theme" class="grid size-8 cursor-pointer list-none place-items-center rounded-lg text-foreground-icon-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-foreground-icon-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring">
				<span data-theme-icon="light">
					@Icon("sun", "size-4")
				</span>
				<span data-theme-icon="dark">
					@Icon("moon", "size-4")
				</span>
				<span data-theme-icon="system">
					@Icon("system", "size-4")
				</span>
			</summary>
			<div class="absolute end-0 top-10 z-40 w-44 rounded-xl border border-border-button-default bg-background-primary-default p-1 shadow-lg">
				@themeChoice("light", "Light", "sun")
				@themeChoice("dark", "Dark", "moon")
				@themeChoice("system", "System", "system")
			</div>
		</details>
	}
}

templ themeChoice(value, label, icon string) {
	<button type="button" data-theme-choice={ value } aria-pressed="false" class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-body-2-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:bg-background-secondary-hover">
		@Icon(icon, "size-4 text-foreground-icon-tertiary")
		<span class="flex-1 text-start">{ label }</span>
		@Icon("check", "size-4 text-link")
	</button>
}

templ homeLink(c Center) {
	<a href={ Href(c, "/") } class="flex min-w-0 items-center gap-2.5 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring">
		@Logo(c)
	</a>
}

/*
topBar runs across every page: the menu that slides in what a section
lists, such as the help center's collections, the logo, a search box
away from the home page, the portal's sections, the theme, a way to a
human and the visitor's sign-in. On narrow screens the sections move
into a menu of their own. The frosted backdrop is a layer of its own,
because a blurred bar would hold the drawer's panel inside itself
instead of against the window.
*/

templ topBar(c Center, m Meta) {
	<header class="sticky top-0 z-30 isolate flex h-14 shrink-0 items-center gap-3 border-b border-separator-border px-4 lg:px-6">
		<span aria-hidden="true" class="absolute inset-0 -z-10 bg-background-full/85 backdrop-blur-xl backdrop-saturate-150"></span>
		if hasDrawer(m) {
			@drawerToggle()
		}
		@homeLink(c)
		if m.Section == "help" && len(m.Trail) > 1 {
			<form action={ Href(c, "/search") } method="get" role="search" class="ms-2 flex h-8 min-w-0 max-w-[18rem] flex-1 items-center gap-2 rounded-lg border border-border-button-default bg-background-secondary-default px-2.5 max-xl:hidden">
				@Icon("search", "size-3.5 shrink-0 text-foreground-icon-tertiary")
				<label for="top-search" class="sr-only">Search the help center</label>
				<input id="top-search" type="search" name="q" placeholder="Search help center" class="min-w-0 flex-1 bg-transparent text-body-2-regular outline-none placeholder:text-text-placeholder"/>
			</form>
		}
		<nav aria-label="Sections" class="ms-auto flex items-center gap-0.5 max-lg:hidden">
			for _, s := range Sections(c) {
				<a
					href={ Href(c, s.Path) }
					if s.Key == m.Section {
						aria-current="page"
					}
					class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:text-text-primary"
				>{ s.Name }</a>
			}
		</nav>
		<div class="flex shrink-0 items-center gap-2 max-lg:ms-auto">
			@themeSwitch(c)
			@AskHuman(c, "inline-flex h-8 items-center gap-1.5 whitespace-nowrap rounded-lg px-2 text-body-medium text-text-secondary transition-colors hover:text-text-primary max-sm:hidden") {
				@Icon("chat", "size-4")
				<span class="max-xl:sr-only">Ask a human</span>
			}
			@account(c)
			<details data-menu class="group relative lg:hidden">
				<summary aria-label="Sections" class="grid size-8 cursor-pointer list-none place-items-center rounded-lg text-foreground-icon-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-foreground-icon-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring">
					@Icon("more", "size-4")
				</summary>
				<div class="absolute end-0 top-11 z-40 w-60 rounded-2xl border border-border-button-default bg-background-primary-default p-2 shadow-lg">
					for _, s := range Sections(c) {
						<a href={ Href(c, s.Path) } class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-body-medium hover:bg-background-secondary-hover">
							@Icon(s.Icon, "size-4 text-foreground-icon-tertiary")
							{ s.Name }
						</a>
					}
				</div>
			</details>
		</div>
	</header>
}

/*
drawerToggle is the menu button that opens the browse drawer. It is a
details element, so the drawer opens and closes without scripts; the
portal's styles slide the drawer in and push the page aside while it is
open, and the portal's script closes it on a click on the page or
Escape.
*/

templ drawerToggle() {
	<details data-drawer>
		<summary aria-label="Browse" class="grid size-8 cursor-pointer list-none place-items-center rounded-lg text-foreground-icon-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-foreground-icon-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring">
			@Icon("menu", "size-4")
		</summary>
	</details>
}

/*
drawerPanel is the drawer itself, beside the page rather than inside it,
so it stays put while the page moves aside to make room for it.
*/

templ drawerPanel(c Center, m Meta, sidebar templ.Component) {
	<aside data-drawer-panel aria-label={ drawerTitle(m) } class="fixed inset-y-0 start-0 z-50 flex flex-col border-e border-separator-border bg-background-full">
		<div class="flex h-14 shrink-0 items-center justify-between px-4">
			<p class="text-body-semibold">{ drawerTitle(m) }</p>
			<button type="button" data-drawer-close aria-label="Close" class="grid size-8 cursor-pointer place-items-center rounded-lg text-foreground-icon-secondary hover:bg-background-secondary-hover">
				@Icon("close", "size-4")
			</button>
		</div>
		if m.Section == "help" {
			<form action={ Href(c, "/search") } method="get" role="search" class="mx-4 mb-3 flex h-9 items-center gap-2 rounded-lg border border-border-button-default bg-background-secondary-default px-2.5">
				@Icon("search", "size-3.5 shrink-0 text-foreground-icon-tertiary")
				<label for="drawer-search" class="sr-only">Search the help center</label>
				<input id="drawer-search" type="search" name="q" placeholder="Search help center" class="min-w-0 flex-1 bg-transparent text-body-2-regular outline-none placeholder:text-text-placeholder"/>
			</form>
		}
		<div class="min-h-0 flex-1 overflow-y-auto px-3 pb-6">
			@sidebar
		</div>
	</aside>
}

/*
hasDrawer says whether a page's section lists anything to browse.
*/
func hasDrawer(m Meta) bool {
	return m.Section == "help" || m.Section == "conversations"
}

func drawerTitle(m Meta) string {
	if m.Section == "conversations" {
		return "Your conversations"
	}
	return "Browse articles"
}

/*
account is the visitor's way in: a sign-in button, or their initials
linking to their conversations once signed in. A reader signed in through
the team's product gets a sign-out button instead; a help center that
takes no sign-in shows neither.
*/

templ account(c Center) {
	if c.Visitor != nil {
		<a href={ Href(c, "/conversations") } title={ c.Visitor.Name } class="flex items-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring">
			@Avatar(*c.Visitor, "size-8 text-caption-1-semibold")
		</a>
	} else if c.SignedIn {
		<form method="post" action={ templ.SafeURL(c.SignOutURL) }>
			<button type="submit" class="inline-flex h-8 cursor-pointer items-center rounded-full border border-border-button-default px-3.5 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">Sign out</button>
		</form>
	} else if c.SignInURL != "" {
		<a href={ templ.SafeURL(c.SignInURL) } class="button-brand inline-flex h-8 items-center whitespace-nowrap rounded-full px-3.5 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">Sign in</a>
	}
}

/*
AskHuman is the way to a person: it opens the messenger where the help
center shows one, so the reader writes in place without signing in,
and otherwise leads to starting a conversation in the portal.
*/

templ AskHuman(c Center, class string) {
	if c.Messenger != "" {
		<button type="button" data-dimmi="open" title="Ask a human" class={ "cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring " + class }>
			{ children... }
		</button>
	} else {
		<a href={ Href(c, "/conversations/new") } title="Ask a human" class={ class }>
			{ children... }
		</a>
	}
}

/*
Logo draws the portal's logo, in its light or dark version to match the
page, or its initial on the brand color with the product's name when it
has none.
*/

templ Logo(c Center) {
	if c.LogoLight != "" {
		<img src={ Path(c, c.LogoLight) } alt={ c.Product } height="22" class="theme-logo-light h-[1.375rem] w-auto"/>
		<img src={ Path(c, c.LogoDark) } alt={ c.Product } height="22" class="theme-logo-dark h-[1.375rem] w-auto"/>
	} else {
		<span class="button-brand grid size-7 shrink-0 place-items-center rounded-lg text-body-semibold" aria-hidden="true">{ Initial(c) }</span>
		<span class="truncate text-headline-semibold text-text-primary">{ c.Product }</span>
	}
}

/*
Icon draws one of the portal's icons in the current text color, at the
size of the text around it until the class gives it its own, so it never
fills the page before the stylesheet arrives.
*/

templ Icon(name, class string) {
	<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true" class={ class }>
		<path d={ iconPath(name) }></path>
	</svg>
}

/*
Avatar draws a person's initials in a circle; Avatars overlaps several.
*/

templ Avatar(p Person, size string) {
	<span title={ p.Name } class={ "grid shrink-0 place-items-center rounded-full bg-background-tertiary-default text-text-secondary ring-2 ring-background-full " + size }>{ p.Initials }</span>
}

templ Avatars(people []Person) {
	<span class="flex -space-x-0.5">
		for _, p := range people {
			@Avatar(p, "size-7 text-caption-2-semibold")
		}
	</span>
}

/*
SidebarHeading names a group of sidebar links.
*/

templ SidebarHeading(title string) {
	<p class="px-2.5 pb-1.5 pt-5 text-caption-1-medium text-text-tertiary first:pt-0">{ title }</p>
}

/*
SidebarLink is a link in the sidebar, marked when it is the page being
shown, with an optional icon or colored dot and a count.
*/

templ SidebarLink(c Center, path, title, icon, dot string, count int, current bool) {
	<a
		href={ Href(c, path) }
		if current {
			aria-current="page"
		}
		class="flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:bg-background-secondary-default aria-[current=page]:text-text-primary"
	>
		if icon != "" {
			@Icon(icon, "size-4 shrink-0 opacity-80")
		}
		if dot != "" {
			<svg viewBox="0 0 8 8" width="8" height="8" class="size-2 shrink-0" aria-hidden="true"><circle cx="4" cy="4" r="4" fill={ dot }></circle></svg>
		}
		<span class="flex-1 truncate">{ title }</span>
		if count > 0 {
			<span class="text-caption-1-medium tabular-nums text-text-tertiary">{ strconv.Itoa(count) }</span>
		}
	</a>
}
