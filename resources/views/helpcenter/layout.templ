package helpcenter

import "strconv"

/*
Layout is the frame of every portal page. A sidebar holds the logo and
what the current section lists, such as the help center's collections;
a top bar shows the trail to the page, the portal's sections and the
visitor's sign-in; the page sits beside them. Turbo Drive swaps pages
in place with a fade, fetching a link while the pointer rests on it;
without scripts every link and form still works. The theme check in the
head applies the theme before anything paints: the team's when it set
light or dark, else the one the reader picked with the switcher in the
top bar, else their system's. The tab shows the company's logo, and with none the page names
an empty icon so browsers do not ask the server for one.
*/

templ Layout(c Center, m Meta, sidebar templ.Component, assets templ.Component) {
	<!DOCTYPE html>
	<html lang="en" style={ BrandStyle(c) } data-on-brand={ OnBrand(c.Brand) } data-appearance={ fixedTheme(c) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ colorScheme(c) }/>
			<meta name="view-transition" content="same-origin"/>
			<meta name="csp-nonce" content={ templ.GetNonce(ctx) }/>
			<title>{ m.Title }</title>
			if m.Description != "" {
				<meta name="description" content={ m.Description }/>
				<meta property="og:description" content={ m.Description }/>
			}
			<meta property="og:title" content={ m.Title }/>
			<meta property="og:site_name" content={ c.Name }/>
			<meta name="theme-color" content={ c.Brand }/>
			if c.LogoLight != "" {
				<link rel="icon" href={ Path(c, c.LogoLight) }/>
			} else {
				<link rel="icon" href="data:,"/>
			}
			if m.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if m.Markdown != "" {
				<link rel="alternate" type="text/markdown" href={ Href(c, m.Markdown) }/>
			}
			<link rel="alternate" type="application/rss+xml" title={ c.Product + " changelog" } href={ Href(c, "/changelog/feed.xml") }/>
			@applyTheme()
			@assets
		</head>
		<body class="bg-background-full font-inter text-text-primary">
			<a href="#main" class="sr-only rounded-xl bg-background-primary-default px-4 py-2 text-body-medium focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50">Skip to content</a>
			<div class="flex min-h-dvh min-w-0 flex-col">
				@topBar(c, m, sidebar)
				<main id="main" class="flex-1 pb-24">
					{ children... }
				</main>
				<footer class="flex justify-center px-4 pb-8">
					<a href="https://trydimmi.com" class="inline-flex items-center gap-1.5 rounded-full border border-border-button-default px-2.5 py-1 text-caption-1-medium text-text-tertiary transition-colors hover:text-text-primary">
						<svg viewBox="4 4 40 40" class="size-3" fill="currentColor" aria-hidden="true">
							<path d="M4 24a20 20 0 0 1 13.7-19L43 30.3A20 20 0 0 1 24 44H11a7 7 0 0 1-7-7Z"></path>
							<path d="M19.8 4.5a20 20 0 0 1 4.9-.5L44 23.3a20 20 0 0 1-.5 4.9Z"></path>
							<path d="M27.6 4.3A20 20 0 0 1 35 7.3l5.7 5.7a20 20 0 0 1 3 7.4Z"></path>
						</svg>
						Powered by dimmi
					</a>
				</footer>
			</div>
		</body>
	</html>
}

/*
applyTheme sets the page's theme before it paints: the team's fixed
one, or the reader's pick kept in this browser, or their system's,
which it then keeps following.
*/

templ applyTheme() {
	<script nonce={ templ.GetNonce(ctx) }>
		(() => { const root = document.documentElement; const dark = matchMedia("(prefers-color-scheme: dark)"); const pick = () => { const fixed = root.dataset.appearance; if (fixed) return fixed; try { return localStorage.getItem("dimmi-portal-theme") || "system" } catch { return "system" } }; const apply = () => { const p = pick(); root.classList.toggle("dark", p === "dark" || (p === "system" && dark.matches)) }; apply(); dark.addEventListener("change", apply); window.dimmiTheme = apply })()
	</script>
}

/*
themeSwitch lets a reader pick light, dark or their system's theme,
shown only where the team left the choice to readers and only once the
portal's script can act on it.
*/

templ themeSwitch(c Center) {
	if fixedTheme(c) == "" {
		<div data-theme-switch hidden role="group" aria-label="Theme" class="flex items-center gap-0.5 rounded-xl border border-border-button-default p-0.5">
			@themeChoice("light", "Light theme", "sun")
			@themeChoice("dark", "Dark theme", "moon")
			@themeChoice("system", "Match my system", "system")
		</div>
	}
}

templ themeChoice(value, label, icon string) {
	<button type="button" data-theme-choice={ value } aria-label={ label } title={ label } aria-pressed="false" class="grid size-7 cursor-pointer place-items-center rounded-lg text-foreground-icon-tertiary outline-none transition-colors hover:text-foreground-icon-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-pressed:bg-background-secondary-default aria-pressed:text-foreground-icon-primary">
		@Icon(icon, "size-3.5")
	</button>
}

templ homeLink(c Center) {
	<a href={ Href(c, "/") } class="flex min-w-0 items-center gap-2.5 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring">
		@Logo(c)
	</a>
}

/*
topBar runs across every page: the menu that slides in what a section
lists, such as the help center's collections, the logo, a search box
away from the home page, the portal's sections, the theme, a way to a
human and the visitor's sign-in. On narrow screens the sections move
into a menu of their own. The frosted backdrop is a layer of its own,
because a blurred bar would hold the drawer's panel inside itself
instead of against the window.
*/

templ topBar(c Center, m Meta, sidebar templ.Component) {
	<header class="sticky top-0 z-30 isolate flex h-14 shrink-0 items-center gap-3 border-b border-separator-border px-4 lg:px-6">
		<span aria-hidden="true" class="absolute inset-0 -z-10 bg-background-full/85 backdrop-blur-xl backdrop-saturate-150"></span>
		if m.Section == "help" || m.Section == "conversations" {
			@drawer(c, m, sidebar)
		}
		@homeLink(c)
		if m.Section == "help" && len(m.Trail) > 1 {
			<form action={ Href(c, "/search") } method="get" role="search" class="ms-2 flex h-8 w-full max-w-[20rem] items-center gap-2 rounded-lg border border-border-button-default bg-background-secondary-default px-2.5 max-md:hidden">
				@Icon("search", "size-3.5 shrink-0 text-foreground-icon-tertiary")
				<label for="top-search" class="sr-only">Search the help center</label>
				<input id="top-search" type="search" name="q" placeholder="Search help center" class="min-w-0 flex-1 bg-transparent text-body-2-regular outline-none placeholder:text-text-placeholder"/>
			</form>
		}
		<nav aria-label="Sections" class="ms-auto flex items-center gap-0.5 max-lg:hidden">
			for _, s := range Sections(c) {
				<a
					href={ Href(c, s.Path) }
					if s.Key == m.Section {
						aria-current="page"
					}
					class="rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:text-text-primary"
				>{ s.Name }</a>
			}
		</nav>
		<div class="flex shrink-0 items-center gap-2 max-lg:ms-auto">
			<div class="max-sm:hidden">
				@themeSwitch(c)
			</div>
			<a href={ Href(c, "/conversations/new") } class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2 text-body-medium text-text-secondary transition-colors hover:text-text-primary max-sm:hidden">
				@Icon("chat", "size-4")
				Ask a human
			</a>
			@account(c)
			<details class="group relative lg:hidden">
				<summary aria-label="Sections" class="grid size-9 cursor-pointer list-none place-items-center rounded-xl border border-border-button-default text-foreground-icon-secondary">
					@Icon("more", "size-4")
				</summary>
				<div class="absolute end-0 top-11 z-40 w-60 rounded-2xl border border-border-button-default bg-background-primary-default p-2 shadow-lg">
					for _, s := range Sections(c) {
						<a href={ Href(c, s.Path) } class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-body-medium hover:bg-background-secondary-hover">
							@Icon(s.Icon, "size-4 text-foreground-icon-tertiary")
							{ s.Name }
						</a>
					}
					<div class="mt-1 flex border-t border-separator-border px-1 pt-2 sm:hidden">
						@themeSwitch(c)
					</div>
				</div>
			</details>
		</div>
	</header>
}

/*
drawer is the menu button and the panel it slides in from the start
edge, holding what the section lists. It is a details element, so it
opens without scripts; the portal's script closes it on a click outside
or Escape.
*/

templ drawer(c Center, m Meta, sidebar templ.Component) {
	<details data-drawer class="group">
		<summary aria-label="Browse" class="grid size-8 cursor-pointer list-none place-items-center rounded-lg text-foreground-icon-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-foreground-icon-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring">
			@Icon("menu", "size-4")
		</summary>
		<div class="fixed inset-0 z-40 bg-black/30 group-open:animate-[fade-in_150ms_ease-out]" aria-hidden="true" data-drawer-backdrop></div>
		<div class="fixed inset-y-0 start-0 z-50 flex w-[22rem] max-w-[90vw] flex-col border-e border-separator-border bg-background-full shadow-xl group-open:animate-[drawer-in_220ms_cubic-bezier(0.22,1,0.36,1)]">
			<div class="flex h-14 shrink-0 items-center justify-between px-4">
				<p class="text-body-semibold">{ drawerTitle(m) }</p>
				<button type="button" data-drawer-close aria-label="Close" class="grid size-8 cursor-pointer place-items-center rounded-lg text-foreground-icon-secondary hover:bg-background-secondary-hover">
					@Icon("close", "size-4")
				</button>
			</div>
			if m.Section == "help" {
				<form action={ Href(c, "/search") } method="get" role="search" class="mx-4 mb-3 flex h-9 items-center gap-2 rounded-lg border border-border-button-default bg-background-secondary-default px-2.5">
					@Icon("search", "size-3.5 shrink-0 text-foreground-icon-tertiary")
					<label for="drawer-search" class="sr-only">Search the help center</label>
					<input id="drawer-search" type="search" name="q" placeholder="Search help center" class="min-w-0 flex-1 bg-transparent text-body-2-regular outline-none placeholder:text-text-placeholder"/>
				</form>
			}
			<div class="min-h-0 flex-1 overflow-y-auto px-3 pb-6">
				@sidebar
			</div>
		</div>
	</details>
}

func drawerTitle(m Meta) string {
	if m.Section == "conversations" {
		return "Your conversations"
	}
	return "Browse articles"
}

/*
account is the visitor's way in: a sign-in button, or their initials
linking to their conversations once signed in. A reader signed in through
the team's product gets a sign-out button instead; a help center that
takes no sign-in shows neither.
*/

templ account(c Center) {
	if c.Visitor != nil {
		<a href={ Href(c, "/conversations") } title={ c.Visitor.Name } class="flex items-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring">
			@Avatar(*c.Visitor, "size-8 text-caption-1-semibold")
		</a>
	} else if c.SignedIn {
		<form method="post" action={ templ.SafeURL(c.SignOutURL) }>
			<button type="submit" class="inline-flex h-8 cursor-pointer items-center rounded-full border border-border-button-default px-3.5 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">Sign out</button>
		</form>
	} else if c.SignInURL != "" {
		<a href={ templ.SafeURL(c.SignInURL) } class="button-brand inline-flex h-8 items-center whitespace-nowrap rounded-full px-3.5 text-body-medium outline-none transition focus-visible:ring-2 focus-visible:ring-border-focus-ring">Sign in</a>
	}
}

/*
Logo draws the portal's logo, in its light or dark version to match the
page, or its initial on the brand color with the product's name when it
has none.
*/

templ Logo(c Center) {
	if c.LogoLight != "" {
		<img src={ Path(c, c.LogoLight) } alt={ c.Product } class="theme-logo-light h-[1.375rem] w-auto"/>
		<img src={ Path(c, c.LogoDark) } alt={ c.Product } class="theme-logo-dark h-[1.375rem] w-auto"/>
	} else {
		<span class="button-brand grid size-7 shrink-0 place-items-center rounded-lg text-body-semibold" aria-hidden="true">{ Initial(c) }</span>
		<span class="truncate text-headline-semibold text-text-primary">{ c.Product }</span>
	}
}

/*
Icon draws one of the portal's icons in the current text color.
*/

templ Icon(name, class string) {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class={ class }>
		<path d={ iconPath(name) }></path>
	</svg>
}

/*
Avatar draws a person's initials in a circle; Avatars overlaps several.
*/

templ Avatar(p Person, size string) {
	<span title={ p.Name } class={ "grid shrink-0 place-items-center rounded-full bg-background-tertiary-default text-text-secondary ring-2 ring-background-full " + size }>{ p.Initials }</span>
}

templ Avatars(people []Person) {
	<span class="flex -space-x-1">
		for _, p := range people {
			@Avatar(p, "size-6 text-caption-2-semibold")
		}
	</span>
}

/*
SidebarHeading names a group of sidebar links.
*/

templ SidebarHeading(title string) {
	<p class="px-2.5 pb-1.5 pt-5 text-caption-1-medium text-text-tertiary first:pt-0">{ title }</p>
}

/*
SidebarLink is a link in the sidebar, marked when it is the page being
shown, with an optional icon or colored dot and a count.
*/

templ SidebarLink(c Center, path, title, icon, dot string, count int, current bool) {
	<a
		href={ Href(c, path) }
		if current {
			aria-current="page"
		}
		class="flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-body-medium text-text-secondary outline-none transition-colors hover:bg-background-secondary-hover hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus-ring aria-[current=page]:bg-background-secondary-default aria-[current=page]:text-text-primary"
	>
		if icon != "" {
			@Icon(icon, "size-4 shrink-0 opacity-80")
		}
		if dot != "" {
			<svg viewBox="0 0 8 8" class="size-2 shrink-0" aria-hidden="true"><circle cx="4" cy="4" r="4" fill={ dot }></circle></svg>
		}
		<span class="flex-1 truncate">{ title }</span>
		if count > 0 {
			<span class="text-caption-1-medium tabular-nums text-text-tertiary">{ strconv.Itoa(count) }</span>
		}
	</a>
}
