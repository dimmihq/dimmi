package accounts

import "github.com/dimmihq/dimmi/framework/i18n"

/*
layout is the frame of every account mail: a narrow column of text in
the recipient's language, closing with why they received it.
*/

templ layout(title string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
		</head>
		<body style="margin:0;padding:0;background:#f6f6f7;">
			<div style="max-width:560px;margin:0 auto;padding:32px 24px;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#1b1b1f;">
				{ children... }
				<p style="margin-top:32px;font-size:12px;color:#6b6b76;">{ i18n.T(ctx, "mail.footer", nil) }</p>
			</div>
		</body>
	</html>
}

/*
greeting opens a mail addressed to a person by name.
*/

templ greeting(name string) {
	<p>{ i18n.T(ctx, "mail.greeting", i18n.Args{"name": name}) }</p>
}

/*
button is the one link a mail asks the reader to follow.
*/

templ button(href, label string) {
	<p style="margin:24px 0;">
		<a href={ templ.SafeURL(href) } style="display:inline-block;padding:10px 18px;border-radius:6px;background:#1b1b1f;color:#ffffff;text-decoration:none;font-weight:600;">{ label }</a>
	</p>
}

/*
code shows a code to type, large enough to read across the room.
*/

templ code(value string) {
	<p style="margin:16px 0;font-size:28px;font-weight:700;letter-spacing:4px;font-family:Menlo,Consolas,monospace;">{ value }</p>
}
