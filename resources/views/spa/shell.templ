package spa

import "github.com/dimmihq/dimmi/resources/views/theme"

/*
Shell is the page every route of the browser app starts from: the
document the app mounts into, in the browser's theme, with the tags
that load it. The app sits behind a sign-in, so search engines are
asked not to index it. When the app reports its errors, the page names
where to, and which environment and release the reports come from. When
the app records sessions, the page names the recorder and its project.
When the server has a messenger for its own teammates, the page names it.
*/

/*
Reporting is where the browser app sends its errors: an empty DSN sends
nothing.
*/
type Reporting struct {
	DSN         string
	Environment string
	Release     string
}

/*
Recording is the session recorder the browser app records on: its origin
and the public key of its project. An empty host records nothing.
*/
type Recording struct {
	Host string
	Key  string
}

/*
Support is the messenger of this server the browser app shows its
signed-in teammates: its app id. An empty one shows none.
*/
type Support struct {
	Messenger string
}

templ Shell(lang, chosenTheme string, reporting Reporting, recording Recording, support Support, assets templ.Component) {
	<!DOCTYPE html>
	<html lang={ lang } class={ theme.Root(chosenTheme) } data-accent="emerald">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<meta name="color-scheme" content="light dark"/>
			if reporting.DSN != "" {
				<meta name="dimmi-errors-dsn" content={ reporting.DSN }/>
				<meta name="dimmi-errors-environment" content={ reporting.Environment }/>
				<meta name="dimmi-errors-release" content={ reporting.Release }/>
			}
			if recording.Host != "" && recording.Key != "" {
				<meta name="dimmi-sessions-host" content={ recording.Host }/>
				<meta name="dimmi-sessions-key" content={ recording.Key }/>
			}
			if support.Messenger != "" {
				<meta name="dimmi-support-messenger" content={ support.Messenger }/>
			}
			<title>Dimmi</title>
			<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,"/>
			@theme.Script()
			@assets
		</head>
		<body class="bg-background-full">
			<div id="root"></div>
		</body>
	</html>
}
