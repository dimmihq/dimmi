{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "widget-jsx",
    "paths": {
      "widget-jsx/jsx-runtime": [
        "./resources/widget/jsx/jsx-runtime.ts"
      ]
    }
  },
  "include": [
    "resources/widget"
  ]
}
