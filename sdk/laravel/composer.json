{
  "name": "dimmi/dimmi-laravel",
  "description": "dimmi for Laravel: the messenger with signed identity, the REST API client, webhooks and artisan checks.",
  "type": "library",
  "license": "MIT",
  "keywords": ["dimmi", "laravel", "support", "messenger", "webhooks"],
  "homepage": "https://github.com/dimmihq/dimmi/tree/main/sdk/laravel",
  "require": {
    "php": ">=8.2",
    "dimmi/dimmi-php": "^0.1",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/routing": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Dimmi\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dimmi\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Dimmi\\Laravel\\DimmiServiceProvider"],
      "aliases": {
        "Dimmi": "Dimmi\\Laravel\\Facades\\Dimmi"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "path",
      "url": "../php",
      "options": {
        "symlink": true,
        "versions": {
          "dimmi/dimmi-php": "0.1.0"
        }
      }
    }
  ]
}
