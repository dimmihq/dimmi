#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Regenerates src/Generated from the dimmi OpenAPI document.
 *
 *     bin/generate [spec-path-or-url]
 *
 * Default source: tests/contracts/api_v1.openapi.json at the repository
 * root, or http://localhost:8080/api/v1/openapi.json when that file is
 * missing. It writes the
 * operation table (operation id => method, path, path and query parameters,
 * request and response schema names) and one small accessor class per
 * resource with PHPDoc, so $dimmi->conversations->messages->store($id, [...])
 * autocompletes. Nothing else is generated: requests go through Client.
 *
 * Public methods never disappear or change shape between runs. The current
 * table is the baseline: an operation the spec dropped is kept and marked
 * @deprecated, path parameter names and the body parameter keep their
 * place, and a body added to an operation that had none goes last.
 */

$root = dirname(__DIR__);
$snapshot = dirname($root, 2) . '/tests/contracts/api_v1.openapi.json';
$source = $argv[1] ?? (is_file($snapshot) ? $snapshot : 'http://localhost:8080/api/v1/openapi.json');
fwrite(STDERR, "generate: reading {$source}\n");

$raw = @file_get_contents($source);
if ($raw === false) {
    fwrite(STDERR, "generate: cannot read {$source}\n");
    exit(1);
}
$spec = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);

$methods = ['get', 'post', 'put', 'patch', 'delete'];
$operations = [];
foreach ($spec['paths'] as $path => $item) {
    foreach ($methods as $method) {
        $op = $item[$method] ?? null;
        if (!is_array($op) || !isset($op['operationId'])) {
            continue;
        }
        preg_match_all('/\{([^}]+)\}/', $path, $m);
        $query = [];
        foreach (array_merge($item['parameters'] ?? [], $op['parameters'] ?? []) as $param) {
            if (isset($param['$ref'])) {
                $param = resolve($spec, $param['$ref']);
            }
            if (($param['in'] ?? '') === 'query') {
                $query[$param['name']] = typeOf($param['schema'] ?? []);
            }
        }
        $body = $op['requestBody']['content']['application/json']['schema'] ?? null;
        $response = null;
        foreach ($op['responses'] ?? [] as $code => $answer) {
            if (is_int($code) || ctype_digit((string) $code)) {
                if ((int) $code >= 200 && (int) $code < 300) {
                    $schema = $answer['content']['application/json']['schema'] ?? null;
                    $response = $schema ? schemaName($schema) : null;
                    break;
                }
            }
        }
        $operations[$op['operationId']] = [
            'method' => strtoupper($method),
            'path' => $path,
            'params' => $m[1],
            'query' => $query,
            'body' => $body ? schemaName($body) : null,
            'bodyRequired' => $body !== null && ($op['requestBody']['required'] ?? false),
            'response' => $response,
            'abilities' => $op['x-abilities'] ?? [],
            'summary' => $op['summary'] ?? null,
        ];
    }
}
$operations = keepCompatible($operations, baseline($root . '/src/Generated/Operations.php'), $warnings);
foreach ($warnings as $warning) {
    fwrite(STDERR, "generate: {$warning}\n");
}
ksort($operations);

// Build the resource tree from the dotted operation ids.
$tree = ['children' => [], 'ops' => []];
foreach ($operations as $id => $op) {
    $segments = explode('.', $id);
    $leaf = array_pop($segments);
    $node = &$tree;
    foreach ($segments as $segment) {
        $node['children'][$segment] ??= ['children' => [], 'ops' => []];
        $node = &$node['children'][$segment];
    }
    $node['ops'][$leaf] = $id;
    unset($node);
}

$out = $root . '/src/Generated';
@mkdir($out . '/Resources', 0777, true);
foreach (glob($out . '/Resources/*.php') ?: [] as $old) {
    unlink($old);
}

$version = $spec['info']['version'] ?? '';
$header = "<?php\n\n// Generated by bin/generate from the dimmi OpenAPI document ({$version}). Do not edit.\n\ndeclare(strict_types=1);\n\n";

// Operation table.
$table = $header . "namespace Dimmi\\Generated;\n\n/**\n * Every API operation by its OpenAPI operation id.\n */\nfinal class Operations\n{\n    public const SPEC_VERSION = " . var_export($version, true) . ";\n\n    public const ALL = [\n";
foreach ($operations as $id => $op) {
    $table .= '        ' . var_export($id, true) . ' => [' .
        "'method' => " . var_export($op['method'], true) .
        ", 'path' => " . var_export($op['path'], true) .
        ", 'params' => " . listExport($op['params']) .
        ", 'query' => " . listExport(array_keys($op['query'])) .
        ", 'body' => " . var_export($op['body'], true) .
        ", 'bodyRequired' => " . var_export($op['bodyRequired'], true) .
        ", 'response' => " . var_export($op['response'], true) .
        ($op['bodyLast'] ? ", 'bodyLast' => true" : '') .
        (($op['bodyDropped'] ?? false) ? ", 'bodyDropped' => true" : '') .
        ($op['deprecated'] ? ", 'deprecated' => true" : '') . "],\n";
}
$table .= "    ];\n}\n";
file_put_contents($out . '/Operations.php', $table);

$classes = [];
emit($tree, [], $out, $header, $operations, $classes);

printf("generate: %d operations (%d deprecated), %d resource classes, spec %s\n", count($operations), count(array_filter($operations, fn ($op) => $op['deprecated'])), count($classes), $version);

function emit(array $node, array $trail, string $out, string $header, array $operations, array &$classes): string
{
    $isRoot = $trail === [];
    $class = $isRoot ? 'Api' : className($trail);
    if (isset($classes[$class])) {
        throw new RuntimeException("generate: two resources map to class {$class}");
    }
    $classes[$class] = true;

    $props = [];
    $map = [];
    ksort($node['children']);
    foreach ($node['children'] as $segment => $child) {
        $childClass = emit($child, [...$trail, $segment], $out, $header, $operations, $classes);
        $name = camel($segment);
        $props[] = " * @property-read Resources\\{$childClass} \${$name}";
        $map[] = '        ' . var_export($name, true) . " => Resources\\{$childClass}::class,";
    }
    $propsDoc = $props === [] ? '' : ' *' . "\n" . implode("\n", $props) . "\n";
    $mapCode = $map === [] ? '' : "    protected const RESOURCES = [\n" . implode("\n", $map) . "\n    ];\n";

    if ($isRoot) {
        $code = $header . "namespace Dimmi\\Generated;\n\n/**\n * The top-level resources of the dimmi API.\n{$propsDoc} */\nabstract class Api\n{\n{$mapCode}}\n";
        file_put_contents($out . '/Api.php', $code);

        return 'Api';
    }

    $methods = [];
    ksort($node['ops']);
    foreach ($node['ops'] as $leaf => $id) {
        $methods[] = method(camel($leaf), $id, $operations[$id]);
    }
    $nice = implode('.', $trail);
    $use = $props === [] ? "use Dimmi\\Resource;\n\n" : "use Dimmi\\Generated\\Resources;\nuse Dimmi\\Resource;\n\n";
    $code = $header . "namespace Dimmi\\Generated\\Resources;\n\n{$use}/**\n * The {$nice} resource.\n{$propsDoc} */\nfinal class {$class} extends Resource\n{\n" .
        ($mapCode !== '' ? $mapCode . ($methods === [] ? '' : "\n") : '') . implode("\n", $methods) . "}\n";
    file_put_contents("{$out}/Resources/{$class}.php", $code);

    return $class;
}

function method(string $name, string $id, array $op): string
{
    $params = [];
    $doc = ["    /**", "     * {$op['method']} {$op['path']}"];
    if ($op['deprecated']) {
        $doc[] = '     *';
        $doc[] = '     * @deprecated The API no longer lists this operation; it will be removed in the next major version.';
    }
    if ($op['summary']) {
        $doc[] = '     *';
        $doc[] = '     * ' . $op['summary'];
    }
    if ($op['abilities']) {
        $doc[] = '     *';
        $doc[] = '     * Needs: ' . implode(', ', $op['abilities']);
    }
    $doc[] = '     *';
    $pathArgs = [];
    $reserved = ['body', 'query', 'options'];
    foreach ($op['params'] as $param) {
        $var = camel(preg_replace('/[^A-Za-z0-9_-]/', '_', $param));
        if (in_array($var, $reserved, true)) {
            $var .= 'Id';
        }
        $params[] = "string|int \${$var}";
        $pathArgs[] = var_export($param, true) . " => \${$var}";
        $doc[] = "     * @param string|int \${$var}";
    }
    $hasBody = $op['body'] !== null;
    $bodyDoc = "     * @param array<string, mixed>|object" . ($op['bodyLast'] ? '|null' : '') . " \$body {$op['body']}";
    if ($hasBody && !$op['bodyLast']) {
        $params[] = $op['bodyRequired'] ? 'array|object $body' : 'array|object $body = []';
        $doc[] = $bodyDoc;
    }
    $params[] = 'array $query = []';
    $doc[] = '     * @param array<string, mixed> $query' . ($op['query'] ? ' ' . implode(', ', array_keys($op['query'])) : '');
    $params[] = 'array $options = []';
    $doc[] = '     * @param array{idempotencyKey?: string, headers?: array<string, string>, timeout?: float} $options';
    if ($hasBody && $op['bodyLast']) {
        $params[] = 'array|object|null $body = null';
        $doc[] = $bodyDoc . ' (last, as the operation had no body before)';
    }
    $doc[] = '     * @return array<string, mixed>|string|null' . ($op['response'] ? " {$op['response']}" : '');
    $doc[] = '     * @throws \\Dimmi\\DimmiException';
    $doc[] = '     */';

    $path = '[' . implode(', ', $pathArgs) . ']';
    $body = !$hasBody ? 'null' : ((($op['bodyDropped'] ?? false) || $op['bodyLast']) ? '($body === [] ? null : $body)' : '$body');

    return implode("\n", $doc) . "\n    public function {$name}(" . implode(', ', $params) . "): array|string|null\n    {\n" .
        "        return \$this->client->call(" . var_export($id, true) . ", {$path}, \$query, {$body}, \$options);\n    }\n";
}

function className(array $trail): string
{
    $name = implode('', array_map(fn ($s) => ucfirst(camel($s)), $trail));
    $reserved = ['abstract', 'and', 'array', 'as', 'break', 'callable', 'case', 'catch', 'class', 'clone', 'const', 'continue', 'declare', 'default', 'do', 'echo', 'else', 'empty', 'enum', 'eval', 'exit', 'extends', 'final', 'finally', 'fn', 'for', 'foreach', 'function', 'global', 'goto', 'if', 'implements', 'include', 'instanceof', 'insteadof', 'interface', 'isset', 'list', 'match', 'namespace', 'new', 'or', 'print', 'private', 'protected', 'public', 'readonly', 'require', 'return', 'static', 'switch', 'throw', 'trait', 'try', 'unset', 'use', 'var', 'while', 'xor', 'yield', 'resource', 'object', 'mixed', 'string', 'int', 'float', 'bool', 'void', 'null', 'true', 'false', 'never', 'iterable'];

    return in_array(strtolower($name), $reserved, true) ? $name . 'Resource' : $name;
}

function camel(string $segment): string
{
    return lcfirst(str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $segment))));
}

function schemaName(array $schema): string
{
    if (isset($schema['$ref'])) {
        return substr($schema['$ref'], strrpos($schema['$ref'], '/') + 1);
    }
    if (($schema['type'] ?? null) === 'array') {
        return schemaName($schema['items'] ?? []) . '[]';
    }

    return is_string($schema['type'] ?? null) ? $schema['type'] : 'object';
}

function typeOf(array $schema): string
{
    $type = $schema['type'] ?? 'string';

    return is_array($type) ? implode('|', $type) : $type;
}

function resolve(array $spec, string $ref): array
{
    $node = $spec;
    foreach (explode('/', substr($ref, 2)) as $part) {
        $node = $node[$part] ?? [];
    }

    return $node;
}

function listExport(array $list): string
{
    return '[' . implode(', ', array_map(fn ($v) => var_export($v, true), $list)) . ']';
}

/**
 * The operation table the SDK last shipped, the baseline for compatibility.
 *
 * @return array<string, array<string, mixed>>
 */
function baseline(string $file): array
{
    if (!is_file($file)) {
        return [];
    }
    $code = (string) file_get_contents($file);
    // Load the old table under a throwaway class name, without autoloading.
    $class = 'GenerateBaseline' . bin2hex(random_bytes(4));
    $code = str_replace(['namespace Dimmi\\Generated;', 'final class Operations'], ['', "final class {$class}"], $code);
    $tmp = tempnam(sys_get_temp_dir(), 'dimmi-ops');
    file_put_contents($tmp, $code);
    require $tmp;
    unlink($tmp);

    return constant("{$class}::ALL");
}

/**
 * Merges the new operations onto the baseline so no public method breaks.
 *
 * @param array<string, array<string, mixed>> $new
 * @param array<string, array<string, mixed>> $old
 * @param list<string> $warnings
 * @return array<string, array<string, mixed>>
 */
function keepCompatible(array $new, array $old, ?array &$warnings): array
{
    $warnings = [];
    foreach ($new as $id => &$op) {
        $op['deprecated'] = false;
        $op['bodyLast'] = false;
        $op['bodyDropped'] = false;
        $before = $old[$id] ?? null;
        if ($before === null) {
            continue;
        }
        if (count($before['params']) === count($op['params'])) {
            // Keep the old argument names; the path template is rewritten to match.
            foreach ($op['params'] as $i => $name) {
                if ($name !== $before['params'][$i]) {
                    $op['path'] = str_replace('{' . $name . '}', '{' . $before['params'][$i] . '}', $op['path']);
                    $warnings[] = "{$id}: path parameter {$name} keeps its old name {$before['params'][$i]}";
                }
            }
            $op['params'] = $before['params'];
        } else {
            $warnings[] = "{$id}: path parameters changed from " . implode(',', $before['params']) . ' to ' . implode(',', $op['params']) . '; this breaks callers, release it as a major version';
        }
        $hadBody = $before['body'] !== null;
        if ($hadBody && !($before['bodyLast'] ?? false) && $op['body'] === null) {
            // Keep the $body argument so positional $query calls still line up.
            $op['body'] = 'object';
            $op['bodyRequired'] = false;
            $op['bodyDropped'] = true;
            $warnings[] = "{$id}: the spec dropped the request body; \$body is kept and optional";
        } elseif (!$hadBody && $op['body'] !== null) {
            $op['bodyLast'] = true;
            $warnings[] = "{$id}: a request body was added; \$body goes last to keep the signature";
        } elseif ($before['bodyDropped'] ?? false) {
            $op['body'] ??= 'object';
            $op['bodyRequired'] = false;
            $op['bodyDropped'] = $op['body'] === 'object';
        } elseif ($before['bodyLast'] ?? false) {
            $op['bodyLast'] = true;
            $op['body'] ??= 'object';
        }
        if ($hadBody && !$before['bodyRequired'] && $op['bodyRequired'] && !$op['bodyLast']) {
            $op['bodyRequired'] = false;
            $warnings[] = "{$id}: the body became required; it stays optional in the signature";
        }
    }
    unset($op);
    foreach ($old as $id => $before) {
        if (!isset($new[$id])) {
            $new[$id] = $before + ['abilities' => [], 'summary' => null];
            $new[$id]['query'] = array_fill_keys($before['query'], 'string');
            $new[$id]['deprecated'] = true;
            $new[$id]['bodyLast'] = $before['bodyLast'] ?? false;
            $new[$id]['bodyDropped'] = $before['bodyDropped'] ?? false;
            $warnings[] = "{$id}: dropped from the spec; kept as @deprecated";
        }
    }

    return $new;
}
