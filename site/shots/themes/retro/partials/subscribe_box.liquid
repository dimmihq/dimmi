{%- comment -%}The changelog's email signup, as a mailing-list form.{%- endcomment -%}
{%- if subscribed %}
<p class="notice">📬 {{ 'check_inbox_to_confirm' | t }}</p>
{%- else %}
<form method="post" action="{{ help_center.subscribe_url }}" class="addressbar">
{{ form_token_field }}
<label for="sub-email">✉ {{ 'email_address' | t }}:</label>
<input id="sub-email" type="email" name="email" required placeholder="you@company.com" autocomplete="email">
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden>
<button type="submit" class="btn">{{ 'subscribe' | t }}</button>
</form>
{%- endif %}
