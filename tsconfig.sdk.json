{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@dimmi/server": ["./sdk/server/src/index.ts"],
      "@dimmi/browser": ["./sdk/browser/src/index.ts"],
      "@dimmi/react": ["./sdk/react/src/index.ts"]
    }
  },
  "include": ["sdk/*/src", "sdk/api/scripts"]
}
