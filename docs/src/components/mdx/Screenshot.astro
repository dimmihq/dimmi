---
/*
 * A product screenshot, captured from a running dimmi by
 * docs/shots/capture.ts in light and dark at twice the pixel density.
 * The picture that matches the reader's theme shows; its size comes from
 * the file, so the page doesn't jump while it loads.
 */
import { readFileSync } from "node:fs";

import { withBase } from "~docs/base";

interface Props {
  /** The shot's name in docs/shots/shots.ts, saved as <name>-light.webp and <name>-dark.webp. */
  name: string;
  /** What the picture shows, for readers and agents who can't see it. */
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const file = (scheme: string) => `/shots/${name}-${scheme}.webp`;

// The canvas size from the WebP header (VP8X, VP8L or VP8 chunk), halved for 2x.
function size(path: string): { width?: number; height?: number } {
  try {
    const b = readFileSync(new URL(`../../../public${path}`, import.meta.url));
    const chunk = b.toString("ascii", 12, 16);
    if (chunk === "VP8X") {
      return { width: (1 + b.readUIntLE(24, 3)) / 2, height: (1 + b.readUIntLE(27, 3)) / 2 };
    }
    if (chunk === "VP8L") {
      const bits = b.readUInt32LE(21);
      return { width: ((bits & 0x3fff) + 1) / 2, height: (((bits >> 14) & 0x3fff) + 1) / 2 };
    }
    return { width: (b.readUInt16LE(26) & 0x3fff) / 2, height: (b.readUInt16LE(28) & 0x3fff) / 2 };
  } catch {
    return {};
  }
}

const dims = size(file("light"));
---
<figure class="not-prose docs-shot">
  <img class="docs-shot-light" src={withBase(file("light"))} alt={alt} loading="lazy" decoding="async" {...dims} />
  <img class="docs-shot-dark" src={withBase(file("dark"))} alt="" aria-hidden="true" loading="lazy" decoding="async" {...dims} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
