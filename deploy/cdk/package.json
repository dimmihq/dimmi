{
  "name": "dimmi-cdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --lookups=false --no-version-reporting --no-notices --quiet",
    "synth:all": "pnpm run synth -c env=staging -o cdk.out/staging && pnpm run synth -c env=production -o cdk.out/production",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "aws-cdk": "2.1147.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
