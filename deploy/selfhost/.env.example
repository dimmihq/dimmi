# Every setting the stack reads, with what install.sh fills in. The real file
# is /opt/dimmi/.env, mode 600. Change it with `dimmictl set KEY=value`, which
# restarts the app. Any dimmi setting can be added as DIMMI_<PATH>, upper case,
# with __ between levels: mail.from.name is DIMMI_MAIL__FROM__NAME.

# ---- Made by install.sh -------------------------------------------------
APP_DOMAIN=support.example.com
ACME_EMAIL=you@example.com
# The release installed; `dimmictl update` moves it.
IMAGE=ghcr.io/dimmihq/dimmi:0.1.0
# Random once, then kept. Changing them locks the app out of its data.
POSTGRES_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
VALKEY_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Encrypts secrets in the database. Back it up; it cannot be recovered.
DIMMI_APP__KEY=base64:

# ---- Optional stack settings --------------------------------------------
# COMPOSE_PROFILES=clamav        # run the malware scanner (needs ~1.5 GB RAM)
# NETWORK_SUBNET=172.29.0.0/24   # change if it clashes with a local network
# CADDY_TLS=tls internal         # local tests only: self-signed certificate

# ---- Outbound mail (references/aws-ses.md, references/options.md) --------
# Without a mailer, mail is written to the logs with its links:
#   dimmictl logs web worker | grep -i link
# DIMMI_MAIL__FROM__NAME=Acme Support
# DIMMI_MAIL__FROM__EMAIL=no-reply@mail.example.com
# DIMMI_MAIL__MAILERS__SYSTEM__DRIVER=ses
# DIMMI_MAIL__MAILERS__SYSTEM__REGION=us-east-1
# DIMMI_MAIL__MAILERS__SYSTEM__ACCESS_KEY_ID=
# DIMMI_MAIL__MAILERS__SYSTEM__SECRET_ACCESS_KEY=
# DIMMI_MAIL__MAILERS__SYSTEM__CONFIGURATION_SET=
# DIMMI_MAIL__MAILERS__CUSTOMER__...   # same keys; replies and broadcasts

# ---- Inbound mail --------------------------------------------------------
# DIMMI_CHANNELS__EMAIL__INBOUND_DOMAIN=inbound.example.com
# DIMMI_CHANNELS__EMAIL__INBOUND__DRIVERS=ses
# DIMMI_MAILBOX__DEFAULT=ses
# DIMMI_MAILBOX__SOURCES__SES__DRIVER=ses
# DIMMI_MAILBOX__SOURCES__SES__TOPIC_ARNS=arn:aws:sns:us-east-1:<account>:dimmi-inbound
# DIMMI_FILESYSTEMS__DISKS__SES_INBOUND__DRIVER=s3
# DIMMI_FILESYSTEMS__DISKS__SES_INBOUND__BUCKET=
# DIMMI_FILESYSTEMS__DISKS__SES_INBOUND__REGION=us-east-1
# DIMMI_FILESYSTEMS__DISKS__SES_INBOUND__ACCESS_KEY_ID=
# DIMMI_FILESYSTEMS__DISKS__SES_INBOUND__SECRET_ACCESS_KEY=

# ---- AI ------------------------------------------------------------------
# DIMMI_AI__MANAGED__ANTHROPIC__API_KEY=
# DIMMI_AI__MANAGED__OPENAI__API_KEY=
# DIMMI_AI__MANAGED__EMBEDDINGS__API_KEY=

# ---- Sign in with Google or GitHub ----------------------------------------
# DIMMI_AUTH__OAUTH__GOOGLE__CLIENT_ID=
# DIMMI_AUTH__OAUTH__GOOGLE__CLIENT_SECRET=
# DIMMI_AUTH__OAUTH__GITHUB__CLIENT_ID=
# DIMMI_AUTH__OAUTH__GITHUB__CLIENT_SECRET=
