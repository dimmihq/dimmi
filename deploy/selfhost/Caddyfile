# The public edge. Caddy gets and renews the certificate for the app's
# domain itself, then proxies everything to the web role. The app only
# ever sees plain HTTP from here.
{
	email {$ACME_EMAIL}
	admin off
	# Certificates for customers' own domains, ordered on a domain's first
	# visit and only after the app allows it. Without custom domains set
	# up in the app, every such request is refused.
	on_demand_tls {
		ask http://web:9090/internal/tls/ask
	}
}

{$APP_DOMAIN} {
	{$CADDY_TLS}
	reverse_proxy web:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:8080
}
