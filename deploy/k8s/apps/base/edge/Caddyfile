# The edge of one environment. The Hetzner load balancer forwards raw TCP
# with a PROXY protocol header, so Caddy learns each visitor's address and
# terminates every TLS connection: the environment's own host with a
# certificate it keeps renewed, and any customer's domain with one ordered
# on its first visit, only after the application's ask endpoint allowed it.
# The application itself only ever sees plain HTTP from here.
{
	email {$ACME_EMAIL}
	# One certificate authority, named in the privacy pages: Let's Encrypt.
	# Without this Caddy may also order from ZeroSSL.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	admin off
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.0.0.0/8
			}
			tls
		}
	}
	on_demand_tls {
		ask http://web:9090/internal/tls/ask
	}
	# The country database the image carries (deploy/k8s/edge), which
	# geoip2_vars reads a visitor's country from.
	order geoip2_vars first
	geoip2 {
		databaseDirectory /usr/share/geoip
		editionID dbip-country-lite
	}
}

# Plain HTTP is its own site, so it reads the PROXY header too: it answers
# certificate challenges and sends everything else to HTTPS.
http:// {
	redir https://{host}{uri} 308
}

# The environment's host serves the marketing site and its docs (the site
# service, static files) beside the app: the site's pages and assets go to
# the site, everything else (the dashboard at /d, the API, sign-in, the
# messenger) to the app. The site's CI job checks that every top-level path
# of its build is listed here (scripts/check-site-paths.sh). The app's gate
# never covers the site; SITE_ROBOTS keeps a non-production site out of
# search engines. HOST_TLS is empty on a server; a machine with no public
# name (local.sh) sets it to "tls internal" for a certificate of Caddy's own.
{$HOST} {
	{$HOST_TLS}
	encode zstd gzip
	@site path / /.well-known/ard.json /favicon.svg /llms.txt /llms-full.txt /og.png /robots.txt /sitemap.xml /docs /docs/* /assets/* /logos/* /og/* /shots/* /agent /agent/* /agent-studio /agent-studio/* /agents /agents/* /broadcasts /broadcasts/* /changelog /changelog/* /channels /channels/* /compare /compare/* /feedback /feedback/* /help-center /help-center/* /inbox /inbox/* /operator /operator/* /pricing /pricing/* /privacy /privacy/* /procedures /procedures/* /reports /reports/* /routines /routines/* /terms /terms/* /tickets /tickets/* /workflows /workflows/*
	handle @site {
		header X-Robots-Tag {$SITE_ROBOTS:all}
		reverse_proxy site:8080
	}
	handle {
		reverse_proxy web:8080
	}
}

# The file store's public host. Browsers read and upload files through
# links the app signed for this host, so the store checks every request's
# signature itself; customers' sites upload from other origins, which the
# store allows here. Environments without a store host leave it unset.
{$FILES_HOST:files.invalid} {
	{$HOST_TLS}
	@preflight method OPTIONS
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, PUT"
		Access-Control-Allow-Headers "*"
		Access-Control-Max-Age "3600"
		-Server
	}
	respond @preflight 204
	# SeaweedFS ignores the name a signed link asks a download to carry, so
	# the edge applies it; the signature covers it, so it cannot be changed.
	@named query response-content-disposition=*
	header @named Content-Disposition "{http.request.uri.query.response-content-disposition}"
	reverse_proxy seaweedfs:8333 {
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Content-Disposition
	}
}

# Sites of an environment's own, each a .caddy file its overlay adds to this
# directory. An environment with none imports nothing.
import /etc/caddy/*.caddy

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:8080
}
