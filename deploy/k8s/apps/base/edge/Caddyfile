# The edge of one environment. The Hetzner load balancer forwards raw TCP
# with a PROXY protocol header, so Caddy learns each visitor's address and
# terminates every TLS connection: the environment's own host with a
# certificate it keeps renewed, and any customer's domain with one ordered
# on its first visit, only after the application's ask endpoint allowed it.
# The application itself only ever sees plain HTTP from here.
{
	email {$ACME_EMAIL}
	admin off
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.0.0.0/8
			}
			tls
		}
	}
	on_demand_tls {
		ask http://web:9090/internal/tls/ask
	}
}

# Plain HTTP is its own site, so it reads the PROXY header too: it answers
# certificate challenges and sends everything else to HTTPS.
http:// {
	redir https://{host}{uri} 308
}

{$HOST} {
	reverse_proxy web:8080
}

# The file store's public host. Browsers read and upload files through
# links the app signed for this host, so the store checks every request's
# signature itself; customers' sites upload from other origins, which the
# store allows here. Environments without a store host leave it unset.
{$FILES_HOST:files.invalid} {
	@preflight method OPTIONS
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, PUT"
		Access-Control-Allow-Headers "*"
		Access-Control-Max-Age "3600"
		-Server
	}
	respond @preflight 204
	reverse_proxy seaweedfs:8333 {
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
	}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:8080
}
