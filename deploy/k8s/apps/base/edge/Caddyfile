# The edge of one environment. The Hetzner load balancer forwards raw TCP
# with a PROXY protocol header, so Caddy learns each visitor's address and
# terminates every TLS connection: the environment's own host with a
# certificate it keeps renewed, and any customer's domain with one ordered
# on its first visit, only after the application's ask endpoint allowed it.
# The application itself only ever sees plain HTTP from here.
{
	email {$ACME_EMAIL}
	admin off
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.0.0.0/8
			}
			tls
		}
	}
	on_demand_tls {
		ask http://web:9090/internal/tls/ask
	}
}

# Plain HTTP is its own site, so it reads the PROXY header too: it answers
# certificate challenges and sends everything else to HTTPS.
http:// {
	redir https://{host}{uri} 308
}

{$HOST} {
	reverse_proxy web:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:8080
}
